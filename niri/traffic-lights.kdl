// macOS window buttons (close / hide / full screen) over the top-left corner
// of every window that lets niri draw its decorations (prefer-no-csd: Qt/KDE
// apps, terminals, mpv, Electron with the system title bar, …). GTK apps keep
// their own headerbar buttons. Needs nix/niri/traffic-lights.patch (package
// niri-loft): a stock niri rejects this file, so sessions include it only when
// they run that niri. Yellow and a held green talk to the shell over niri's
// IPC (WindowMinimizeRequested / WindowActionsMenuRequested, services/Niri.qml).
//
// Turn them off or move them per app with a window rule:
//
//     window-rule {
//         match app-id="^mpv$"
//         traffic-lights { off; }
//     }
//     window-rule {
//         match app-id="^org.kde.dolphin$"
//         traffic-lights { offset x=16 y=18; }
//     }
layout {
    traffic-lights {
        on
        size 12
        spacing 8
        offset x=14 y=14
    }
}

// The shell's own windows draw their own traffic lights (WindowChrome.qml).
window-rule {
    match app-id=r"^org\.quickshell$"
    traffic-lights { off; }
}
