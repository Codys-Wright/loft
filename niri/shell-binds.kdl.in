// Shell keybinds — generated from shell-binds.kdl.in (IPC command substituted).
// Included by loft-session / loft-dev after base.kdl.
binds {
    Mod+Shift+R hotkey-overlay-title="Reload shell" { spawn @IPC@ "shell" "reload"; }
    Mod+Space hotkey-overlay-title="Spotlight" { spawn "loft-launcher" "open"; }
    Mod+Period hotkey-overlay-title="Emoji & Symbols" { spawn "loft-launcher" "emoji"; }
    Mod+A hotkey-overlay-title="Control Center" { spawn @IPC@ "controlcenter" "toggle"; }
    Mod+I hotkey-overlay-title="Island" { spawn @IPC@ "island" "toggle"; }
    Mod+Shift+T hotkey-overlay-title="Themes" { spawn @IPC@ "themes" "open"; }
    Mod+F10 hotkey-overlay-title="App Menu" { spawn @IPC@ "appmenu" "toggle"; }
    Mod+Comma hotkey-overlay-title="Settings" { spawn @IPC@ "settings" "toggle"; }
    Mod+Shift+W hotkey-overlay-title="Wallpapers" { spawn @IPC@ "wallpaper" "toggle"; }
    Ctrl+Shift+Escape hotkey-overlay-title="System Monitor" { spawn @IPC@ "monitor" "toggle"; }
    // macOS ⌘⇧5 / ⌘⇧4 / ⌘⇧3 on Cmd (physical Super), not the WM Mod — so
    // Mod+Shift+3–5 keep moving windows to workspaces.
    Super+Shift+5 hotkey-overlay-title="Capture" { spawn @IPC@ "capture" "toggle"; }
    Super+Shift+4 hotkey-overlay-title="Capture Area" { spawn @IPC@ "capture" "area"; }
    Super+Shift+3 hotkey-overlay-title="Capture Screen" { spawn @IPC@ "capture" "screen"; }
    // macOS Ctrl+Cmd+Q.
    Mod+Ctrl+Q hotkey-overlay-title="Lock Screen" { spawn @IPC@ "lock" "lock"; }
    Mod+Shift+V hotkey-overlay-title="Clipboard History" { spawn @IPC@ "clipboard" "toggle"; }
    Mod+Shift+Alt+V hotkey-overlay-title="Paste as Plain Text" { spawn @IPC@ "clipboard" "pastePlain"; }
    Mod+Shift+Period hotkey-overlay-title="Snippets" { spawn @IPC@ "snippets" "toggle"; }
    Mod+Shift+N hotkey-overlay-title="Scratchpad" { spawn @IPC@ "scratchpad" "toggle"; }
    Mod+Shift+O hotkey-overlay-title="Next Audio Output" { spawn @IPC@ "audio" "nextOutput"; }
    Mod+Shift+M hotkey-overlay-title="Mute Microphones" { spawn @IPC@ "mic" "toggleMute"; }
    // ⌘Q through the shell (src/everyday/QuitGuard.qml): apps with quit
    // protection need it held; the rest close the focused window as before.
    // Alt+F4 is what xremap's macOS layout sends for ⌘Q. Without a shell to
    // answer, plain close-window. cooldown-ms throttles the held key's repeats.
    Mod+Q cooldown-ms=100 hotkey-overlay-title="Close Window (hold to quit protected apps)" { spawn "sh" "-c" "\"$@\" quit key || niri msg action close-window" "loft-quit" @IPC@; }
    Alt+F4 cooldown-ms=100 hotkey-overlay-title=null { spawn "sh" "-c" "\"$@\" quit key || niri msg action close-window" "loft-quit" @IPC@; }
    Mod+Ctrl+A hotkey-overlay-title="Arrange Window" { spawn @IPC@ "arrange" "open"; }
}

// ⌘Tab: niri's recent-windows switcher (live previews). xremap sends a
// physical ⌘Tab as Alt+Tab and ⌘` as Alt+grave; Super+Tab covers keyboards
// without the remap, Mod+Tab the window-manager key. The theme's niri.kdl
// sets the highlight colors and radius.
recent-windows {
    open-delay-ms 120
    binds {
        Alt+Tab           { next-window; }
        Alt+Shift+Tab     { previous-window; }
        Alt+grave         { next-window     filter="app-id"; }
        Alt+Shift+grave   { previous-window filter="app-id"; }
        Super+Tab         { next-window; }
        Super+Shift+Tab   { previous-window; }
        Super+grave       { next-window     filter="app-id"; }
        Super+Shift+grave { previous-window filter="app-id"; }
        Mod+Tab           { next-window; }
        Mod+Shift+Tab     { previous-window; }
        Mod+grave         { next-window     filter="app-id"; }
        Mod+Shift+grave   { previous-window filter="app-id"; }
    }
}
