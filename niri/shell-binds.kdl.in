// Shell keybinds — generated from shell-binds.kdl.in (IPC command substituted).
// Included by studio-session / studio-dev after base.kdl.
binds {
    Mod+Tab hotkey-overlay-title="Switch apps" { spawn @IPC@ "switcher" "next"; }
    Mod+Shift+Tab { spawn @IPC@ "switcher" "prev"; }
    Mod+A hotkey-overlay-title="Control Center" { spawn @IPC@ "controlcenter" "toggle"; }
    Mod+I hotkey-overlay-title="Island" { spawn @IPC@ "island" "toggle"; }
}
