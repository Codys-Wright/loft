{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loft.dev/schema/facets/icons.json",
  "title": "Loft icons facet data (resolved)",
  "description": "The `data` of a resolved facet: after fill, polar values and @color references (docs/THEME-ARCHITECTURE.md \u00a72, \u00a73.4). Facet documents may leave keys out and use {dark, light} / @refs.",
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "colorAlpha": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
    }
  },
  "type": "object",
  "properties": {
    "icons": {
      "type": "object",
      "properties": {
        "theme": {
          "type": [
            "string",
            "null"
          ]
        },
        "fallback": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "cursor": {
      "type": "object",
      "properties": {
        "theme": {
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 8,
              "maximum": 256
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
