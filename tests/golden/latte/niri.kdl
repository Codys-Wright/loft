// studio-linux theme "latte" — generated by `studio theme render`, do not edit.
//
// Included after studio's base.kdl (include optional=true ".../current/niri.kdl"),
// so it overrides only the theme-owned settings below.

layout {
    focus-ring {
        active-color "#1e66f5cc"
        inactive-color "#00000000"
        urgent-color "#d20f39"
    }

    // Colors only: whether the border is drawn stays the base/consumer's call.
    border {
        active-color "#1e66f5"
        inactive-color "#bcc0cc"
        urgent-color "#d20f39"
    }

    shadow {
        color "#0000002e"
    }
}

overview {
    backdrop-color "#eff1f5"
}

// glass.blur, glass.noise, glass.saturation. `off` also disables blur that
// windows request themselves; `on` re-enables it after an earlier `off`.
blur {
    on
    noise 0.02
    saturation 1.6
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

