// Generated by `loft-niri space render` from the spaces (SPACES.md). Do not
// edit: change the spaces, then render again. Included once, after base.kdl.

workspace "main" {
    open-on-output "BOE 0x0BCA Unknown"
}

workspace "setup" {
    open-on-output "BOE 0x0BCA Unknown"
}

workspace "music" {
    open-on-output "BOE 0x0BCA Unknown"
}

workspace "music/right" {
    open-on-output "BOE 0x0BCA Unknown"
}

workspace "video" {
    open-on-output "BOE 0x0BCA Unknown"
}

workspace "media" {
    open-on-output "BOE 0x0BCA Unknown"
}

workspace "recording" {
    open-on-output "BOE 0x0BCA Unknown"
}

workspace "comms/main" {
    open-on-output "BOE 0x0BCA Unknown"
}

workspace "comms" {
    open-on-output "BOE 0x0BCA Unknown"
}

workspace "gaming" {
    open-on-output "BOE 0x0BCA Unknown"
    layout {
        border {
            off
        }
        focus-ring {
            off
        }
        struts {
            top 0
        }
    }
}

workspace "stream" {
    open-on-output "BOE 0x0BCA Unknown"
}

workspace "task" {
    open-on-output "BOE 0x0BCA Unknown"
}

workspace "notes" {
    open-on-output "BOE 0x0BCA Unknown"
}

workspace "research" {
    open-on-output "BOE 0x0BCA Unknown"
}

workspace "loft" {
    open-on-output "BOE 0x0BCA Unknown"
}

workspace "loft/left" {
    open-on-output "BOE 0x0BCA Unknown"
}

workspace "loft/right" {
    open-on-output "BOE 0x0BCA Unknown"
}

workspace "inferno" {
    open-on-output "BOE 0x0BCA Unknown"
}

workspace "inferno/left" {
    open-on-output "BOE 0x0BCA Unknown"
}

workspace "inferno/right" {
    open-on-output "BOE 0x0BCA Unknown"
}

window-rule {
    match app-id="^loft\\.proj-loft\\.debug$"
    open-on-workspace "loft"
    open-focused false
    default-column-width {
        proportion 0.33
    }
}

window-rule {
    match app-id="^loft\\.proj-inferno\\.debug$"
    open-on-workspace "inferno"
    open-focused false
    default-column-width {
        proportion 0.33
    }
}

window-rule {
    match app-id="^loft\\.proj-inferno\\.run$"
    open-on-workspace "inferno/right"
    open-focused false
    default-column-width {
        proportion 0.33
    }
}
