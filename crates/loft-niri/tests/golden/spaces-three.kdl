// Generated by `loft-niri space render` from the spaces (SPACES.md). Do not
// edit: change the spaces, then render again. Included once, after base.kdl.

workspace "main" {
    open-on-output "Microstep MPG491CX OLED Unknown"
}

workspace "setup" {
    open-on-output "Acer Technologies XV271U M3 13210337C3LAJ"
}

workspace "music" {
    open-on-output "Microstep MPG491CX OLED Unknown"
}

workspace "music/right" {
    open-on-output "Acer Technologies XV271U M3 13210337C3LAJ"
}

workspace "video" {
    open-on-output "Microstep MPG491CX OLED Unknown"
}

workspace "media" {
    open-on-output "Acer Technologies XV271U M3 1321033793LAJ"
}

workspace "recording" {
    open-on-output "Acer Technologies XV271U M3 13210337C3LAJ"
}

workspace "comms/main" {
    open-on-output "Microstep MPG491CX OLED Unknown"
}

workspace "comms" {
    open-on-output "Acer Technologies XV271U M3 1321033793LAJ"
}

workspace "gaming" {
    open-on-output "Microstep MPG491CX OLED Unknown"
    layout {
        border {
            off
        }
        focus-ring {
            off
        }
        struts {
            top 0
        }
    }
}

workspace "stream" {
    open-on-output "Acer Technologies XV271U M3 13210337C3LAJ"
}

workspace "task" {
    open-on-output "Microstep MPG491CX OLED Unknown"
}

workspace "notes" {
    open-on-output "Acer Technologies XV271U M3 1321033793LAJ"
}

workspace "research" {
    open-on-output "Acer Technologies XV271U M3 13210337C3LAJ"
}

workspace "loft" {
    open-on-output "Microstep MPG491CX OLED Unknown"
}

workspace "loft/left" {
    open-on-output "Acer Technologies XV271U M3 1321033793LAJ"
}

workspace "loft/right" {
    open-on-output "Acer Technologies XV271U M3 13210337C3LAJ"
}

workspace "inferno" {
    open-on-output "Microstep MPG491CX OLED Unknown"
}

workspace "inferno/left" {
    open-on-output "Acer Technologies XV271U M3 1321033793LAJ"
}

workspace "inferno/right" {
    open-on-output "Acer Technologies XV271U M3 13210337C3LAJ"
}

window-rule {
    match app-id="^loft\\.proj-loft\\.debug$"
    open-on-workspace "loft"
    open-focused false
    default-column-width {
        proportion 0.33
    }
}

window-rule {
    match app-id="^loft\\.proj-inferno\\.debug$"
    open-on-workspace "inferno"
    open-focused false
    default-column-width {
        proportion 0.33
    }
}

window-rule {
    match app-id="^loft\\.proj-inferno\\.run$"
    open-on-workspace "inferno/right"
    open-focused false
    default-column-width {
        proportion 0.33
    }
}

binds {
    Mod+1 hotkey-overlay-title="Space: Main" {
        spawn "loft-niri" "space" "focus" "main"
    }
    Mod+2 hotkey-overlay-title="Space: Music" {
        spawn "loft-niri" "space" "focus" "music"
    }
    Mod+3 hotkey-overlay-title="Space: Video" {
        spawn "loft-niri" "space" "focus" "video"
    }
    Mod+4 hotkey-overlay-title="Space: Communication" {
        spawn "loft-niri" "space" "focus" "comms"
    }
    Mod+5 hotkey-overlay-title="Space: Gaming" {
        spawn "loft-niri" "space" "focus" "gaming"
    }
    Mod+6 hotkey-overlay-title="Space: Task" {
        spawn "loft-niri" "space" "focus" "task"
    }
    Mod+7 hotkey-overlay-title="Space: Project: loft" {
        spawn "loft-niri" "space" "focus" "proj-loft"
    }
    Mod+8 hotkey-overlay-title="Space: Project: Inferno" {
        spawn "loft-niri" "space" "focus" "proj-inferno"
    }
    Mod+Shift+1 hotkey-overlay-title="Move Window to Main" {
        spawn "loft-niri" "space" "move-window" "main"
    }
    Mod+Shift+2 hotkey-overlay-title="Move Window to Music" {
        spawn "loft-niri" "space" "move-window" "music"
    }
    Mod+Shift+3 hotkey-overlay-title="Move Window to Video" {
        spawn "loft-niri" "space" "move-window" "video"
    }
    Mod+Shift+4 hotkey-overlay-title="Move Window to Communication" {
        spawn "loft-niri" "space" "move-window" "comms"
    }
    Mod+Shift+5 hotkey-overlay-title="Move Window to Gaming" {
        spawn "loft-niri" "space" "move-window" "gaming"
    }
    Mod+Shift+6 hotkey-overlay-title="Move Window to Task" {
        spawn "loft-niri" "space" "move-window" "task"
    }
    Mod+Shift+7 hotkey-overlay-title="Move Window to Project: loft" {
        spawn "loft-niri" "space" "move-window" "proj-loft"
    }
    Mod+Shift+8 hotkey-overlay-title="Move Window to Project: Inferno" {
        spawn "loft-niri" "space" "move-window" "proj-inferno"
    }
    Mod+Ctrl+Left hotkey-overlay-title="Previous Space" {
        spawn "loft-niri" "space" "prev"
    }
    Mod+Ctrl+Right hotkey-overlay-title="Next Space" {
        spawn "loft-niri" "space" "next"
    }
    Mod+Page_Up hotkey-overlay-title=null {
        spawn "loft-niri" "space" "prev"
    }
    Mod+Page_Down hotkey-overlay-title=null {
        spawn "loft-niri" "space" "next"
    }
    Mod+Alt+Page_Up {
        focus-workspace-up
    }
    Mod+Alt+Page_Down {
        focus-workspace-down
    }
}
