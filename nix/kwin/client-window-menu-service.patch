+void Workspace::showClientWindowMenu(Window *window, const QPointF &globalPos, std::function<void()> fallback)
+{
+    const QString service = options->clientWindowMenuService();
+    if (service.isEmpty()) {
+        fallback();
+        return;
+    }
+    QDBusMessage message = QDBusMessage::createMethodCall(service, QStringLiteral("/WindowMenu"),
+                                                          QStringLiteral("org.kde.KWin.ClientWindowMenu"), QStringLiteral("Show"));
+    message << window->internalId().toString() << globalPos.x() << globalPos.y();
+    auto watcher = new QDBusPendingCallWatcher(QDBusConnection::sessionBus().asyncCall(message, 1000), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [guard = QPointer<Window>(window), fallback = std::move(fallback)](QDBusPendingCallWatcher *watcher) {
+        const QDBusPendingReply<bool> reply = *watcher;
+        watcher->deleteLater();
+        if (guard && !guard->isDeleted() && (reply.isError() || !reply.value())) {
+            fallback();
+        }
+    });
+}
