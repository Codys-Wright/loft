-HWAccel::~HWAccel() = default;
+// VAAPI decoders share one device (VADisplay) while any of them is alive.
+// nvidia-vaapi-driver backs each device with its own CUDA context, a few
+// hundred MB of VRAM apiece: with a device per player, every video
+// wallpaper paid that again.
+static std::mutex sharedVaapiMutex;
+static AVBufferRef *sharedVaapiDevice = nullptr;
+
+// Drops the shared device when nothing but `alsoHeld` other references
+// (the dying HWAccel's own) still use it.
+static void releaseSharedVaapiIfUnused(int alsoHeld = 0)
+{
+    std::lock_guard lock(sharedVaapiMutex);
+    if (sharedVaapiDevice && av_buffer_get_ref_count(sharedVaapiDevice) == 1 + alsoHeld)
+        av_buffer_unref(&sharedVaapiDevice);
+}
+
+HWAccel::~HWAccel()
+{
+    m_hwFramesContext.reset();
+    if (m_hwDeviceContext && hwDeviceContext()->type == AV_HWDEVICE_TYPE_VAAPI) {
+        // m_hwDeviceContext is const and goes after this body: if it is the
+        // shared device's only other reference, drop the shared one now.
+        releaseSharedVaapiIfUnused(1);
+        // The codec context and frames still in flight hold the device a
+        // little longer; look again once they are gone.
+        if (auto *app = QCoreApplication::instance())
+            QTimer::singleShot(3000, app, [] { releaseSharedVaapiIfUnused(); });
+    }
+}
 
 HWAccelUPtr HWAccel::create(AVHWDeviceType deviceType)
 {
+    if (deviceType == AV_HWDEVICE_TYPE_VAAPI) {
+        std::lock_guard lock(sharedVaapiMutex);
+        if (!sharedVaapiDevice) {
+            auto ctx = loadHWContext(deviceType);
+            if (!ctx)
+                return {};
+            sharedVaapiDevice = av_buffer_ref(ctx.get());
+            return HWAccelUPtr(new HWAccel(std::move(ctx)));
+        }
+        return HWAccelUPtr(new HWAccel(AVBufferUPtr(av_buffer_ref(sharedVaapiDevice))));
+    }
     if (auto ctx = loadHWContext(deviceType))
         return HWAccelUPtr(new HWAccel(std::move(ctx)));
     else
