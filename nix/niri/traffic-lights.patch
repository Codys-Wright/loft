+    /// Sets the pointer contents, updating the hover state of the traffic lights it leaves and
+    /// enters.
+    pub fn set_pointer_contents(&mut self, under: &PointContents) {
+        fn traffic_lights(contents: &PointContents) -> Option<(Window, Option<TrafficLight>)> {
+            match &contents.window {
+                Some((window, HitType::TrafficLights { button })) => {
+                    Some((window.clone(), *button))
+                }
+                _ => None,
+            }
+        }
+
+        let old = traffic_lights(&self.pointer_contents);
+        let new = traffic_lights(under).filter(|_| !self.layout.is_overview_open());
+        self.pointer_contents.clone_from(under);
+
+        if old == new {
+            return;
+        }
+
+        let mut changed = false;
+        if let Some((window, _)) = &old {
+            if new.as_ref().map(|(w, _)| w) != Some(window) {
+                changed |= self.update_traffic_lights_input(window, |input| {
+                    input.hovered = false;
+                    input.under = None;
+                });
+            }
+        }
+        if let Some((window, button)) = new {
+            changed |= self.update_traffic_lights_input(&window, |input| {
+                input.hovered = true;
+                input.under = button;
+            });
+        }
+
+        if changed {
+            // FIXME: granular.
+            self.queue_redraw_all();
+        }
+    }
+
+    /// Changes a window's traffic lights input state; returns whether it changed.
+    pub fn update_traffic_lights_input(
+        &self,
+        window: &Window,
+        f: impl FnOnce(&mut TrafficLightsInput),
+    ) -> bool {
+        let Some(toplevel) = window.toplevel() else {
+            return false;
+        };
+        let Some((mapped, _)) = self.layout.find_window_and_output(toplevel.wl_surface()) else {
+            return false;
+        };
+        let mut input = mapped.traffic_lights_input();
+        f(&mut input);
+        mapped.set_traffic_lights_input(input)
+    }
