+/// macOS-style window buttons (close, minimize, zoom) at the left of the title bar.
+///
+/// They show only where the title bar does; `off` keeps a bar without buttons.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct TrafficLights {
+    pub on: bool,
+    /// Diameter of one button.
+    pub size: f64,
+    /// Space between two buttons.
+    pub spacing: f64,
+    /// `x`: inset of the first button from the bar's left edge. `y` is ignored: the buttons are
+    /// centered in the bar (it was their offset from the window's corner before the title bar).
+    pub offset: ShadowOffset,
+    pub close_color: Color,
+    pub minimize_color: Color,
+    pub zoom_color: Color,
+    /// Color of all buttons while the window is inactive and the pointer is not over them.
+    pub inactive_color: Color,
+    /// Color of the glyphs shown while the pointer is over the buttons.
+    pub glyph_color: Color,
+}
+
+impl Default for TrafficLights {
+    fn default() -> Self {
+        Self {
+            on: true,
+            size: 12.,
+            spacing: 8.,
+            offset: ShadowOffset {
+                x: FloatOrInt(12.),
+                y: FloatOrInt(0.),
+            },
+            close_color: Color::from_rgba8_unpremul(0xff, 0x5f, 0x57, 0xff),
+            minimize_color: Color::from_rgba8_unpremul(0xfe, 0xbc, 0x2e, 0xff),
+            zoom_color: Color::from_rgba8_unpremul(0x28, 0xc8, 0x40, 0xff),
+            inactive_color: Color::from_rgba8_unpremul(0x80, 0x80, 0x80, 0x59),
+            glyph_color: Color::from_rgba8_unpremul(0, 0, 0, 0x99),
+        }
+    }
+}
+
+impl MergeWith<TrafficLightsRule> for TrafficLights {
+    fn merge_with(&mut self, part: &TrafficLightsRule) {
+        self.on |= part.on;
+        if part.off {
+            self.on = false;
+        }
+
+        merge!((self, part), size, spacing);
+
+        merge_clone!(
+            (self, part),
+            offset,
+            close_color,
+            minimize_color,
+            zoom_color,
+            inactive_color,
+            glyph_color,
+        );
+    }
+}
+
+#[derive(knuffel::Decode, Debug, Default, Clone, Copy, PartialEq)]
+pub struct TrafficLightsRule {
+    #[knuffel(child)]
+    pub off: bool,
+    #[knuffel(child)]
+    pub on: bool,
+    #[knuffel(child, unwrap(argument))]
+    pub size: Option<FloatOrInt<1, 256>>,
+    #[knuffel(child, unwrap(argument))]
+    pub spacing: Option<FloatOrInt<0, 256>>,
+    #[knuffel(child)]
+    pub offset: Option<ShadowOffset>,
+    #[knuffel(child)]
+    pub close_color: Option<Color>,
+    #[knuffel(child)]
+    pub minimize_color: Option<Color>,
+    #[knuffel(child)]
+    pub zoom_color: Option<Color>,
+    #[knuffel(child)]
+    pub inactive_color: Option<Color>,
+    #[knuffel(child)]
+    pub glyph_color: Option<Color>,
+}
+
+impl MergeWith<Self> for TrafficLightsRule {
+    fn merge_with(&mut self, part: &Self) {
+        merge_on_off!((self, part));
+
+        merge_clone_opt!(
+            (self, part),
+            size,
+            spacing,
+            offset,
+            close_color,
+            minimize_color,
+            zoom_color,
+            inactive_color,
+            glyph_color,
+        );
+    }
+}
+
+/// A server-side title bar above windows that use server-side decorations, like KWin's.
+///
+/// The tile reserves its height: the window gets the tile minus the bar, below it.
+#[derive(Debug, Clone, PartialEq)]
+pub struct TitleBar {
+    pub on: bool,
+    pub height: f64,
+    /// Bar background of the focused window.
+    pub active_color: Color,
+    /// Bar background of other windows.
+    pub inactive_color: Color,
+    pub active_text_color: Color,
+    pub inactive_text_color: Color,
+    /// Pango font description of the title.
+    pub font: String,
+}
+
+impl Default for TitleBar {
+    fn default() -> Self {
+        Self {
+            on: false,
+            height: 30.,
+            active_color: Color::from_rgba8_unpremul(0x2c, 0x2c, 0x30, 0xff),
+            inactive_color: Color::from_rgba8_unpremul(0x22, 0x22, 0x26, 0xff),
+            active_text_color: Color::from_rgba8_unpremul(0xe6, 0xe6, 0xea, 0xff),
+            inactive_text_color: Color::from_rgba8_unpremul(0x8a, 0x8a, 0x90, 0xff),
+            font: String::from("sans 13px"),
+        }
+    }
+}
+
+impl MergeWith<TitleBarRule> for TitleBar {
+    fn merge_with(&mut self, part: &TitleBarRule) {
+        self.on |= part.on;
+        if part.off {
+            self.on = false;
+        }
+
+        merge!((self, part), height);
+
+        merge_clone!(
+            (self, part),
+            active_color,
+            inactive_color,
+            active_text_color,
+            inactive_text_color,
+            font,
+        );
+    }
+}
+
+#[derive(knuffel::Decode, Debug, Default, Clone, PartialEq)]
+pub struct TitleBarRule {
