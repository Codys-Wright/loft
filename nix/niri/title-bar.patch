diff --git a/src/layout/tests/title_bar.rs b/src/layout/tests/title_bar.rs
--- a/src/layout/tests/title_bar.rs
+++ b/src/layout/tests/title_bar.rs
@@ -0,0 +1,277 @@
+//! The title bar is part of the tile: the tile reserves its height and the window goes below it.
+//!
+//! The test output is 1280 × 720 with the default 16 px gaps, so a lone tiled window's tile is
+//! 720 - 2 × 16 = 688 px tall.
+
+use super::*;
+use crate::layout::traffic_lights::TrafficLight;
+
+fn ssd(id: usize) -> TestWindowParams {
+    TestWindowParams {
+        has_ssd: true,
+        ..TestWindowParams::new(id)
+    }
+}
+
+fn options() -> Options {
+    Options {
+        layout: niri_config::Layout {
+            title_bar: niri_config::TitleBar {
+                on: true,
+                height: 30.,
+                ..Default::default()
+            },
+            ..Default::default()
+        },
+        ..Default::default()
+    }
+}
+
+fn tile(layout: &Layout<TestWindow>, id: usize) -> &Tile<TestWindow> {
+    layout
+        .active_workspace()
+        .unwrap()
+        .tiles()
+        .find(|tile| tile.window().0.id == id)
+        .unwrap()
+}
+
+fn requested_height(layout: &Layout<TestWindow>, id: usize) -> i32 {
+    let (_, win) = layout.windows().find(|(_, w)| w.0.id == id).unwrap();
+    win.requested_size().unwrap().h
+}
+
+#[test]
+fn tiled_window_goes_below_the_bar() {
+    let ops = [
+        Op::AddOutput(1),
+        Op::AddWindow { params: ssd(1) },
+        Op::Communicate(1),
+        Op::CompleteAnimations,
+    ];
+    let layout = check_ops_with_options(options(), ops);
+
+    // The window gets the tile minus the bar…
+    assert_eq!(requested_height(&layout, 1), 688 - 30);
+    let tile = tile(&layout, 1);
+    assert_eq!(tile.window_size().h, 658.);
+    // …the tile keeps its height, and the window sits right under the bar.
+    assert_eq!(tile.tile_size().h, 688.);
+    assert_eq!(tile.window_loc(), Point::from((0., 30.)));
+    assert_eq!(tile.title_bar_height(), 30.);
+
+    // The bar takes input: the traffic lights at its left, the rest is the bar itself.
+    assert!(matches!(
+        tile.hit(Point::from((18., 15.))),
+        Some(HitType::TitleBar {
+            button: Some(TrafficLight::Close)
+        })
+    ));
+    assert!(matches!(
+        tile.hit(Point::from((90., 15.))),
+        Some(HitType::TitleBar { button: None })
+    ));
+    // Below the bar is the window.
+    assert!(!matches!(
+        tile.hit(Point::from((90., 45.))),
+        Some(HitType::TitleBar { .. })
+    ));
+}
+
+#[test]
+fn csd_window_gets_no_bar() {
+    let ops = [
+        Op::AddOutput(1),
+        Op::AddWindow {
+            params: TestWindowParams::new(1),
+        },
+        Op::Communicate(1),
+    ];
+    let layout = check_ops_with_options(options(), ops);
+
+    assert_eq!(requested_height(&layout, 1), 688);
+    let tile = tile(&layout, 1);
+    assert_eq!(tile.title_bar_height(), 0.);
+    assert_eq!(tile.window_loc(), Point::from((0., 0.)));
+}
+
+#[test]
+fn window_rule_turns_the_bar_off() {
+    let mut params = ssd(1);
+    params.rules = Some(ResolvedWindowRules {
+        title_bar: niri_config::TitleBarRule {
+            off: true,
+            ..Default::default()
+        },
+        ..Default::default()
+    });
+    let ops = [
+        Op::AddOutput(1),
+        Op::AddWindow { params },
+        Op::Communicate(1),
+    ];
+    let layout = check_ops_with_options(options(), ops);
+
+    // The window grows into the whole tile.
+    assert_eq!(requested_height(&layout, 1), 688);
+    assert_eq!(tile(&layout, 1).window_loc(), Point::from((0., 0.)));
+}
+
+#[test]
+fn window_rule_sets_the_height() {
+    let mut params = ssd(1);
+    params.rules = Some(ResolvedWindowRules {
+        title_bar: niri_config::TitleBarRule {
+            height: Some(FloatOrInt(24.)),
+            ..Default::default()
+        },
+        ..Default::default()
+    });
+    let ops = [
+        Op::AddOutput(1),
+        Op::AddWindow { params },
+        Op::Communicate(1),
+    ];
+    let layout = check_ops_with_options(options(), ops);
+
+    assert_eq!(requested_height(&layout, 1), 688 - 24);
+    assert_eq!(tile(&layout, 1).window_loc(), Point::from((0., 24.)));
+}
+
+#[test]
+fn bar_sits_inside_the_border() {
+    let mut options = options();
+    options.layout.border.off = false;
+    options.layout.border.width = 4.;
+    let ops = [
+        Op::AddOutput(1),
+        Op::AddWindow { params: ssd(1) },
+        Op::Communicate(1),
+    ];
+    let layout = check_ops_with_options(options, ops);
+
+    assert_eq!(requested_height(&layout, 1), 688 - 8 - 30);
+    let tile = tile(&layout, 1);
+    assert_eq!(tile.tile_size().h, 688.);
+    assert_eq!(tile.window_loc(), Point::from((4., 34.)));
+    assert!(matches!(
+        tile.hit(Point::from((90., 4. + 15.))),
+        Some(HitType::TitleBar { button: None })
+    ));
+}
+
+#[test]
+fn fullscreen_drops_the_bar() {
+    let ops = [
+        Op::AddOutput(1),
+        Op::AddWindow { params: ssd(1) },
+        Op::Communicate(1),
+        Op::FullscreenWindow(1),
+        Op::Communicate(1),
+        Op::CompleteAnimations,
+    ];
+    let mut layout = check_ops_with_options(options(), ops);
+
+    assert_eq!(requested_height(&layout, 1), 720);
+    {
+        let tile = tile(&layout, 1);
+        assert_eq!(tile.effective_title_bar_height(), 0.);
+        assert_eq!(tile.window_loc(), Point::from((0., 0.)));
+        assert!(!matches!(
+            tile.hit(Point::from((90., 15.))),
+            Some(HitType::TitleBar { .. })
+        ));
+    }
+
+    // And it comes back after.
+    check_ops_on_layout(
+        &mut layout,
+        [
+            Op::FullscreenWindow(1),
+            Op::Communicate(1),
+            Op::CompleteAnimations,
+        ],
+    );
+    assert_eq!(requested_height(&layout, 1), 688 - 30);
+    assert_eq!(tile(&layout, 1).window_loc(), Point::from((0., 30.)));
+}
+
+#[test]
+fn maximized_window_keeps_the_bar() {
+    let mut options = options();
+    options.layout.border.off = false;
+    options.layout.border.width = 4.;
+    let ops = [
+        Op::AddOutput(1),
+        Op::AddWindow { params: ssd(1) },
+        Op::Communicate(1),
+        Op::MaximizeWindowToEdges { id: Some(1) },
+        Op::Communicate(1),
+        Op::CompleteAnimations,
+    ];
+    let layout = check_ops_with_options(options, ops);
+
+    // Like KWin: no border, but the bar stays, and the window gets the rest of the screen.
+    assert_eq!(requested_height(&layout, 1), 720 - 30);
+    let tile = tile(&layout, 1);
+    assert_eq!(tile.tile_size().h, 720.);
+    assert_eq!(tile.window_loc(), Point::from((0., 30.)));
+}
+
+#[test]
+fn floating_tile_adds_the_bar() {
+    let mut params = ssd(1);
+    params.is_floating = true;
+    let ops = [
+        Op::AddOutput(1),
+        Op::AddWindow { params },
+        Op::Communicate(1),
+    ];
+    let layout = check_ops_with_options(options(), ops);
+
+    // Floating windows keep their size; the tile grows by the bar.
+    let tile = tile(&layout, 1);
+    assert_eq!(tile.window_size(), Size::from((100., 200.)));
+    assert_eq!(tile.tile_size(), Size::from((100., 230.)));
+    assert_eq!(tile.window_loc(), Point::from((0., 30.)));
+}
+
+#[test]
+fn new_window_size_leaves_room_for_the_bar() {
+    let ops = [Op::AddOutput(1)];
+    let layout = check_ops_with_options(options(), ops);
+    let ws = layout.active_workspace().unwrap();
+    let rules = ResolvedWindowRules::default();
+
+    let size = ws.scrolling().new_window_size(None, None, &rules, 30.);
+    assert_eq!(size.h, 688 - 30);
+    let size = ws.scrolling().new_window_size(None, None, &rules, 0.);
+    assert_eq!(size.h, 688);
+
+    // Proportional heights are tile heights: the bar comes out of them too.
+    let half = Some(PresetSize::Proportion(0.5));
+    let size = ws.floating().new_window_size(None, half, &rules, 30.);
+    assert_eq!(size.h, 360 - 30);
+}
+
+#[test]
+fn title_bar_rules_merge() {
+    let config = niri_config::TitleBar {
+        on: true,
+        ..Default::default()
+    };
+    let off = niri_config::TitleBarRule {
+        off: true,
+        ..Default::default()
+    };
+    assert!(!config.clone().merged_with(&off).on);
+
+    let on = niri_config::TitleBarRule {
+        on: true,
+        height: Some(FloatOrInt(40.)),
+        ..Default::default()
+    };
+    let merged = niri_config::TitleBar::default().merged_with(&on);
+    assert!(merged.on);
+    assert_eq!(merged.height, 40.);
+}
