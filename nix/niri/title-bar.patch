+    /// Handles the left button going down on a title bar, off its traffic lights: a drag moves
+    /// the window (as a client's own title bar does through xdg `move`), a double-click toggles
+    /// maximize (as GTK's header bar does through xdg `set_maximized`).
+    fn title_bar_pointer_down(&mut self, window: smithay::desktop::Window, button_code: u32, serial: smithay::utils::Serial) {
+        let pointer = self.niri.seat.get_pointer().unwrap();
+        self.niri.layout.activate_window(&window);
+
+        let time = get_monotonic_time();
+        let is_double = matches!(
+            &self.niri.title_bar_last_press,
+            Some((last, last_time))
+                if *last == window && time.saturating_sub(*last_time) <= DOUBLE_CLICK_TIME
+        );
+
+        if is_double {
+            self.niri.title_bar_last_press = None;
+            if let Some(id) = self.mapped_id(&window) {
+                self.do_action(Action::MaximizeWindowToEdgesById(id), false);
+            }
+        } else {
+            self.niri.title_bar_last_press = Some((window.clone(), time));
+
+            let start_data = PointerGrabStartData {
+                focus: None,
+                button: button_code,
+                location: pointer.current_location(),
+            };
+            let start_data = PointerOrTouchStartData::Pointer(start_data);
+            if let Some(grab) = MoveGrab::new(self, start_data, window, true, None) {
+                pointer.set_grab(self, grab, serial, Focus::Clear);
+            }
+        }
+
+        // FIXME: granular.
+        self.niri.queue_redraw_all();
+    }
+
+    /// Right-click on a title bar: asks the shell for its window menu at the pointer.
+    fn title_bar_menu(&mut self, window: smithay::desktop::Window) {
+        let Some(id) = self.mapped_id(&window) else {
+            return;
+        };
+        let pos = self.niri.seat.get_pointer().unwrap().current_location();
+        let (output, pos) = match self.niri.output_under(pos) {
+            Some((output, pos_within_output)) => (Some(output.name()), pos_within_output),
+            None => (None, pos),
+        };
+        self.ipc_window_actions_menu_requested(id, output, pos);
+    }
+
+    /// The IPC id of a mapped window.
+    fn mapped_id(&self, window: &smithay::desktop::Window) -> Option<u64> {
+        let toplevel = window.toplevel()?;
+        let (mapped, _) = self
+            .niri
+            .layout
+            .find_window_and_output(toplevel.wl_surface())?;
+        Some(mapped.id().get())
+    }
+
+    /// Handles the left button going down over a window's traffic lights.
+    ///
+    /// Returns `false` when the pointer isn't over them.
+    fn traffic_light_pointer_down(&mut self) -> bool {
+        let Some((window, HitType::TitleBar {
+            button: Some(button),
+        })) = self.niri.pointer_contents.window.clone()
+        else {
+            return false;
+        };
+
+        let serial = self
+            .niri
+            .traffic_light_press
+            .as_ref()
+            .map_or(0, |press| press.serial.wrapping_add(1));
+        self.niri.traffic_light_press = Some(TrafficLightPress {
+            window: window.clone(),
+            button,
+            serial,
+            held: false,
+        });
+        self.niri
+            .update_traffic_lights_input(&window, |input| input.pressed = Some(button));
+
+        // Press and hold zoom for the window actions menu, as on macOS.
+        if button == TrafficLight::Zoom {
+            let timer = Timer::from_duration(TRAFFIC_LIGHT_HOLD_TIME);
+            self.niri
+                .event_loop
+                .insert_source(timer, move |_, _, state| {
+                    state.traffic_light_hold(serial);
+                    TimeoutAction::Drop
+                })
+                .unwrap();
+        }
+
+        // FIXME: granular.
+        self.niri.queue_redraw_all();
+        true
+    }
+
+    fn traffic_light_hold(&mut self, serial: u64) {
+        let Some(press) = &mut self.niri.traffic_light_press else {
+            return;
+        };
+        if press.serial != serial || press.held {
+            return;
+        }
+        press.held = true;
+        let window = press.window.clone();
+
+        let Some(toplevel) = window.toplevel() else {
+            return;
+        };
+        let Some((mapped, _)) = self
+            .niri
+            .layout
+            .find_window_and_output(toplevel.wl_surface())
+        else {
+            return;
+        };
+        let id = mapped.id().get();
+
+        let pos = self.niri.seat.get_pointer().unwrap().current_location();
+        let (output, pos) = match self.niri.output_under(pos) {
+            Some((output, pos_within_output)) => (Some(output.name()), pos_within_output),
+            None => (None, pos),
+        };
+
+        self.niri
+            .update_traffic_lights_input(&window, |input| input.pressed = None);
+        self.ipc_window_actions_menu_requested(id, output, pos);
+
+        // FIXME: granular.
+        self.niri.queue_redraw_all();
+    }
+
+    /// Handles the left button going up after it went down over a traffic light: the button
+    /// acts if the pointer is still over it.
+    fn traffic_light_pointer_up(&mut self) {
+        let Some(press) = self.niri.traffic_light_press.take() else {
+            return;
+        };
+
+        self.niri
+            .update_traffic_lights_input(&press.window, |input| input.pressed = None);
+        // FIXME: granular.
+        self.niri.queue_redraw_all();
+
+        if press.held {
+            return;
+        }
+
+        let still_over = matches!(
+            &self.niri.pointer_contents.window,
+            Some((window, HitType::TitleBar { button: Some(button) }))
+                if *window == press.window && *button == press.button
+        );
+        if !still_over {
+            return;
+        }
+
+        let Some(toplevel) = press.window.toplevel() else {
+            return;
+        };
+        let Some((mapped, _)) = self
+            .niri
+            .layout
+            .find_window_and_output(toplevel.wl_surface())
+        else {
+            return;
+        };
+        let id = mapped.id().get();
+
+        match press.button {
+            TrafficLight::Close => mapped.toplevel().send_close(),
+            TrafficLight::Minimize => self.ipc_window_minimize_requested(id),
+            TrafficLight::Zoom => self.do_action(Action::FullscreenWindowById(id), false),
+        }
+    }
+
