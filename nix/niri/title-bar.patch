diff --git a/src/layout/title_bar.rs b/src/layout/title_bar.rs
--- a/src/layout/title_bar.rs
+++ b/src/layout/title_bar.rs
@@ -0,0 +1,396 @@
+//! A server-side title bar, like KWin's: a strip above a window with server-side decorations,
+//! with the traffic lights at the left and the title centered.
+//!
+//! The tile reserves the bar's height (`Tile::title_bar_height()`), so the window gets the tile
+//! minus the bar and the bar never covers it. Window rules turn it off per app, and then the window
+//! gets the whole tile again.
+
+use std::cell::RefCell;
+
+use anyhow::{ensure, Context as _};
+use niri_config::{Color, CornerRadius, GradientInterpolation};
+use pangocairo::cairo::{self, ImageSurface};
+use pangocairo::pango::{EllipsizeMode, FontDescription};
+use smithay::backend::renderer::element::Kind;
+use smithay::backend::renderer::gles::GlesTexture;
+use smithay::reexports::gbm::Format as Fourcc;
+use smithay::utils::{Logical, Point, Rectangle, Size, Transform};
+
+use super::traffic_lights::{TrafficLight, TrafficLights, TrafficLightsInput};
+use crate::niri_render_elements;
+use crate::render_helpers::border::BorderRenderElement;
+use crate::render_helpers::memory::MemoryBuffer;
+use crate::render_helpers::primary_gpu_texture::PrimaryGpuTextureRenderElement;
+use crate::render_helpers::renderer::NiriRenderer;
+use crate::render_helpers::solid_color::{SolidColorBuffer, SolidColorRenderElement};
+use crate::render_helpers::texture::{TextureBuffer, TextureRenderElement};
+use crate::utils::{round_logical_in_physical, to_physical_precise_round};
+
+/// Space between the traffic lights (or the bar's edge) and the title.
+const TITLE_PADDING: f64 = 12.;
+
+/// Titles narrower than this aren't drawn at all.
+const MIN_TITLE_WIDTH: f64 = 24.;
+
+/// The bar's height: whole logical pixels, so window heights (integers) plus the bar add up to
+/// whole tile heights at integer scales, then rounded to physical pixels.
+pub fn rounded_height(height: f64, scale: f64) -> f64 {
+    round_logical_in_physical(scale, height.round().max(1.))
+}
+
+niri_render_elements! {
+    TitleBarRenderElement => {
+        Background = BorderRenderElement,
+        SolidColor = SolidColorRenderElement,
+        Texture = PrimaryGpuTextureRenderElement,
+    }
+}
+
+#[derive(Debug)]
+pub struct TitleBar {
+    config: niri_config::TitleBar,
+    /// Config height rounded to physical pixels.
+    height: f64,
+    traffic_lights: TrafficLights,
+    /// The bar's rounded background; kept across frames so damage tracking sees one element.
+    background: BorderRenderElement,
+    /// Background without the border shader (no rounded corners).
+    fallback_background: SolidColorBuffer,
+    title: RefCell<TitleCache>,
+}
+
+/// What a title texture shows.
+#[derive(Debug, Clone, PartialEq)]
+struct TitleLook {
+    title: String,
+    color: Color,
+    scale_bits: u64,
+}
+
+#[derive(Debug, Default)]
+struct TitleCache {
+    look: Option<TitleLook>,
+    /// The title at its natural width.
+    full: Option<Option<TextureBuffer<GlesTexture>>>,
+    /// The title ellipsized to a maximum physical width, when the full one doesn't fit.
+    ellipsized: Option<(i32, Option<TextureBuffer<GlesTexture>>)>,
+}
+
+impl TitleBar {
+    pub fn new(
+        config: niri_config::TitleBar,
+        traffic_lights: niri_config::TrafficLights,
+        scale: f64,
+    ) -> Self {
+        Self {
+            height: rounded_height(config.height, scale),
+            config,
+            traffic_lights: TrafficLights::new(traffic_lights),
+            background: BorderRenderElement::empty(),
+            fallback_background: SolidColorBuffer::default(),
+            title: RefCell::new(TitleCache::default()),
+        }
+    }
+
+    pub fn update_config(
+        &mut self,
+        config: niri_config::TitleBar,
+        traffic_lights: niri_config::TrafficLights,
+        scale: f64,
+    ) {
+        self.height = rounded_height(config.height, scale);
+        if self.config != config {
+            self.config = config;
+            *self.title.get_mut() = TitleCache::default();
+        }
+        self.traffic_lights.update_config(traffic_lights);
+    }
+
+    pub fn is_on(&self) -> bool {
+        self.config.on
+    }
+
+    /// The bar's height, rounded to physical pixels.
+    pub fn height(&self) -> f64 {
+        self.height
+    }
+
+    pub fn update_render_elements(
+        &mut self,
+        size: Size<f64, Logical>,
+        is_active: bool,
+        radius: CornerRadius,
+        scale: f64,
+        alpha: f32,
+    ) {
+        let color = if is_active {
+            self.config.active_color
+        } else {
+            self.config.inactive_color
+        };
+        let area = Rectangle::from_size(size);
+        self.background.update(
+            size,
+            area,
+            GradientInterpolation::default(),
+            color,
+            color,
+            0.,
+            area,
+            // Zero width fills the whole area.
+            0.,
+            radius.fit_to(size.w as f32, size.h as f32),
+            scale as f32,
+            alpha,
+        );
+        self.fallback_background.update(size, color);
+    }
+
+    /// Hit-tests a point relative to the bar: the traffic light under it, or `None` for the rest
+    /// of the bar.
+    pub fn hit(
+        &self,
+        point: Point<f64, Logical>,
+        size: Size<f64, Logical>,
+        scale: f64,
+    ) -> Option<TrafficLight> {
+        self.traffic_lights.hit(point, size, scale)
+    }
+
+    /// Room for the title: centered in the bar, clear of the traffic lights on both sides.
+    fn title_area(&self, size: Size<f64, Logical>, scale: f64) -> f64 {
+        let side = self.traffic_lights.end_x(size, scale) + TITLE_PADDING;
+        size.w - side * 2.
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    pub fn render<R: NiriRenderer>(
+        &self,
+        renderer: &mut R,
+        location: Point<f64, Logical>,
+        size: Size<f64, Logical>,
+        scale: f64,
+        is_active: bool,
+        input: TrafficLightsInput,
+        title: Option<&str>,
+        alpha: f32,
+        push: &mut dyn FnMut(TitleBarRenderElement),
+    ) {
+        if alpha <= 0. || size.w <= 0. || size.h <= 0. {
+            return;
+        }
+
+        if let Some(elem) = self.traffic_lights.render(
+            renderer, location, size, scale, is_active, input, alpha,
+        ) {
+            push(elem.into());
+        }
+
+        let max_width = self.title_area(size, scale);
+        if let Some(title) = title.filter(|t| !t.is_empty() && max_width >= MIN_TITLE_WIDTH) {
+            let color = if is_active {
+                self.config.active_text_color
+            } else {
+                self.config.inactive_text_color
+            };
+            let look = TitleLook {
+                title: title.to_owned(),
+                color,
+                scale_bits: scale.to_bits(),
+            };
+            if let Some(buffer) = self.title_texture(renderer, look, max_width, scale) {
+                let text_size = buffer.logical_size();
+                let offset = Point::from((
+                    round_logical_in_physical(scale, (size.w - text_size.w) / 2.),
+                    round_logical_in_physical(scale, (size.h - text_size.h) / 2.),
+                ));
+                let elem = TextureRenderElement::from_texture_buffer(
+                    buffer,
+                    location + offset,
+                    alpha,
+                    None,
+                    None,
+                    Kind::Unspecified,
+                );
+                push(PrimaryGpuTextureRenderElement(elem).into());
+            }
+        }
+
+        // The background's size, color, radius and alpha were set in update_render_elements().
+        if BorderRenderElement::has_shader(renderer) {
+            push(self.background.clone().with_location(location).into());
+        } else {
+            let elem = SolidColorRenderElement::from_buffer(
+                &self.fallback_background,
+                location,
+                alpha,
+                Kind::Unspecified,
+            );
+            push(elem.into());
+        }
+    }
+
+    /// The title texture: the full title when it fits in `max_width`, else one ellipsized to it.
+    fn title_texture<R: NiriRenderer>(
+        &self,
+        renderer: &mut R,
+        look: TitleLook,
+        max_width: f64,
+        scale: f64,
+    ) -> Option<TextureBuffer<GlesTexture>> {
+        let mut cache = self.title.borrow_mut();
+        if cache.look.as_ref() != Some(&look) {
+            *cache = TitleCache {
+                look: Some(look.clone()),
+                ..Default::default()
+            };
+        }
+
+        let font = &self.config.font;
+        let full = cache
+            .full
+            .get_or_insert_with(|| {
+                let buffer = draw_title(font, &look.title, look.color, None, scale)
+                    .map_err(|err| warn!("error drawing window title: {err:?}"))
+                    .ok()?;
+                TextureBuffer::from_memory_buffer(renderer.as_gles_renderer(), &buffer)
+                    .map_err(|err| warn!("error uploading window title: {err:?}"))
+                    .ok()
+            })
+            .clone()?;
+
+        if full.logical_size().w <= max_width {
+            return Some(full);
+        }
+
+        let max_px = to_physical_precise_round::<i32>(scale, max_width).max(1);
+        if cache.ellipsized.as_ref().map(|(w, _)| *w) != Some(max_px) {
+            let buffer = draw_title(font, &look.title, look.color, Some(max_px), scale)
+                .map_err(|err| warn!("error drawing window title: {err:?}"))
+                .ok()
+                .and_then(|buffer| {
+                    TextureBuffer::from_memory_buffer(renderer.as_gles_renderer(), &buffer)
+                        .map_err(|err| warn!("error uploading window title: {err:?}"))
+                        .ok()
+                });
+            cache.ellipsized = Some((max_px, buffer));
+        }
+        cache.ellipsized.as_ref().and_then(|(_, b)| b.clone())
+    }
+}
+
+/// Draws a one-line title, ellipsized at the end to `max_width` physical pixels if given.
+fn draw_title(
+    font: &str,
+    title: &str,
+    color: Color,
+    max_width: Option<i32>,
+    scale: f64,
+) -> anyhow::Result<MemoryBuffer> {
+    let _span = tracy_client::span!("title_bar::draw_title");
+
+    let mut font = FontDescription::from_string(font);
+    font.set_absolute_size(to_physical_precise_round(scale, font.size()));
+
+    let surface = ImageSurface::create(cairo::Format::ARgb32, 0, 0)?;
+    let cr = cairo::Context::new(&surface)?;
+    let layout = pangocairo::functions::create_layout(&cr);
+    layout.context().set_round_glyph_positions(false);
+    layout.set_single_paragraph_mode(true);
+    layout.set_font_description(Some(&font));
+    if let Some(max_width) = max_width {
+        layout.set_width(max_width * pangocairo::pango::SCALE);
+        layout.set_ellipsize(EllipsizeMode::End);
+    }
+    layout.set_text(title);
+
+    let (width, height) = layout.pixel_size();
+    ensure!(width > 0 && height > 0, "empty title layout");
+    let width = width.min(max_width.unwrap_or(16383)).min(16383);
+    let height = height.min(16383);
+
+    let surface = ImageSurface::create(cairo::Format::ARgb32, width, height)?;
+    let cr = cairo::Context::new(&surface)?;
+    cr.set_source_rgba(
+        color.r.into(),
+        color.g.into(),
+        color.b.into(),
+        color.a.into(),
+    );
+    pangocairo::functions::show_layout(&cr, &layout);
+    drop(cr);
+
+    let data = surface.take_data().context("taking surface data")?;
+    Ok(MemoryBuffer::new(
+        data.to_vec(),
+        Fourcc::Argb8888,
+        (width, height),
+        scale,
+        Transform::Normal,
+    ))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn title_area_clears_traffic_lights() {
+        let bar = TitleBar::new(
+            niri_config::TitleBar {
+                on: true,
+                ..Default::default()
+            },
+            niri_config::TrafficLights::default(),
+            1.,
+        );
+        assert_eq!(bar.height(), 30.);
+        // Traffic lights end at 64; 12 px padding on each side of the centered title.
+        assert_eq!(bar.title_area(Size::from((400., 30.)), 1.), 400. - 76. * 2.);
+
+        let bar = TitleBar::new(
+            niri_config::TitleBar::default(),
+            niri_config::TrafficLights {
+                on: false,
+                ..Default::default()
+            },
+            1.,
+        );
+        assert_eq!(bar.title_area(Size::from((400., 30.)), 1.), 400. - 24.);
+    }
+
+    #[test]
+    fn height_rounds_to_physical_pixels() {
+        let bar = TitleBar::new(
+            niri_config::TitleBar {
+                height: 29.,
+                ..Default::default()
+            },
+            niri_config::TrafficLights::default(),
+            1.5,
+        );
+        // 29 * 1.5 = 43.5 → 44 physical px.
+        assert_eq!(bar.height(), 44. / 1.5);
+        // Whole logical pixels first, even where half ones would be physical-aligned.
+        assert_eq!(rounded_height(12.5, 2.), 13.);
+    }
+
+    #[test]
+    fn draws_titles() {
+        let buffer = draw_title("sans 13px", "Terminal", Color::new_unpremul(1., 1., 1., 1.), None, 2.)
+            .unwrap();
+        let full = buffer.size();
+        assert!(full.w > 0 && full.h > 0);
+
+        let long = "A very long window title that will not fit in a narrow bar at all";
+        let buffer = draw_title(
+            "sans 13px",
+            long,
+            Color::new_unpremul(1., 1., 1., 1.),
+            Some(100),
+            1.,
+        )
+        .unwrap();
+        assert!(buffer.size().w <= 100);
+    }
+}
diff --git a/src/layout/traffic_lights.rs b/src/layout/traffic_lights.rs
--- a/src/layout/traffic_lights.rs
+++ b/src/layout/traffic_lights.rs
@@ -0,0 +1,464 @@
+//! macOS-style window buttons: close, minimize and zoom, at the left of a window's title bar
+//! (see `title_bar.rs`), vertically centered in it.
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::f64::consts::PI;
+
+use anyhow::Context as _;
+use niri_config::Color;
+use pangocairo::cairo::{self, ImageSurface, LinearGradient};
+use smithay::backend::renderer::element::Kind;
+use smithay::backend::renderer::gles::GlesTexture;
+use smithay::reexports::gbm::Format as Fourcc;
+use smithay::utils::{Logical, Point, Rectangle, Size, Transform};
+
+use crate::render_helpers::memory::MemoryBuffer;
+use crate::render_helpers::primary_gpu_texture::PrimaryGpuTextureRenderElement;
+use crate::render_helpers::renderer::NiriRenderer;
+use crate::render_helpers::texture::{TextureBuffer, TextureRenderElement};
+use crate::utils::round_logical_in_physical;
+
+/// One of the three buttons.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum TrafficLight {
+    Close,
+    Minimize,
+    Zoom,
+}
+
+const BUTTONS: [TrafficLight; 3] = [
+    TrafficLight::Close,
+    TrafficLight::Minimize,
+    TrafficLight::Zoom,
+];
+
+/// Pointer state over a window's traffic lights, kept by the window and set by the input code.
+#[derive(Debug, Default, Clone, Copy, PartialEq, Eq)]
+pub struct TrafficLightsInput {
+    /// The pointer is over the group: every button lights up and shows its glyph.
+    pub hovered: bool,
+    /// The button under the pointer.
+    pub under: Option<TrafficLight>,
+    /// The button the pointer pressed and still holds.
+    pub pressed: Option<TrafficLight>,
+}
+
+/// What a texture shows; one texture is cached per look.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+struct Look {
+    scale_bits: u64,
+    lit: bool,
+    glyphs: bool,
+    pressed: Option<TrafficLight>,
+}
+
+#[derive(Debug)]
+pub struct TrafficLights {
+    config: niri_config::TrafficLights,
+    textures: RefCell<HashMap<Look, Option<TextureBuffer<GlesTexture>>>>,
+}
+
+impl TrafficLights {
+    pub fn new(config: niri_config::TrafficLights) -> Self {
+        Self {
+            config,
+            textures: RefCell::new(HashMap::new()),
+        }
+    }
+
+    pub fn update_config(&mut self, config: niri_config::TrafficLights) {
+        if self.config != config {
+            self.config = config;
+            self.textures.get_mut().clear();
+        }
+    }
+
+    pub fn is_on(&self) -> bool {
+        self.config.on
+    }
+
+    fn size(&self, scale: f64) -> f64 {
+        round_logical_in_physical(scale, self.config.size).max(1.)
+    }
+
+    fn spacing(&self, scale: f64) -> f64 {
+        round_logical_in_physical(scale, self.config.spacing)
+    }
+
+    /// The group of buttons relative to the bar: `offset.x` from its left edge, centered
+    /// vertically.
+    fn group(&self, bar_size: Size<f64, Logical>, scale: f64) -> Rectangle<f64, Logical> {
+        let size = self.size(scale);
+        let spacing = self.spacing(scale);
+        let loc = Point::from((
+            round_logical_in_physical(scale, self.config.offset.x.0),
+            round_logical_in_physical(scale, (bar_size.h - size) / 2.),
+        ));
+        Rectangle::new(loc, Size::from((size * 3. + spacing * 2., size)))
+    }
+
+    /// Where the group ends horizontally, relative to the bar's left edge; 0 when off.
+    pub fn end_x(&self, bar_size: Size<f64, Logical>, scale: f64) -> f64 {
+        if !self.is_shown(bar_size, scale) {
+            return 0.;
+        }
+        let group = self.group(bar_size, scale);
+        group.loc.x + group.size.w
+    }
+
+    /// Whether the buttons are on and fit in a bar of this size.
+    pub fn is_shown(&self, bar_size: Size<f64, Logical>, scale: f64) -> bool {
+        if !self.config.on {
+            return false;
+        }
+        let group = self.group(bar_size, scale);
+        let end = group.loc + group.size.to_point();
+        group.loc.x >= 0. && group.loc.y >= 0. && end.x <= bar_size.w && end.y <= bar_size.h
+    }
+
+    /// Hit-tests a point relative to the bar.
+    ///
+    /// Returns the button under the point, or `None` outside the group. The area reaches half the
+    /// spacing around the buttons, so there are no dead gaps between them.
+    pub fn hit(
+        &self,
+        point: Point<f64, Logical>,
+        bar_size: Size<f64, Logical>,
+        scale: f64,
+    ) -> Option<TrafficLight> {
+        if !self.is_shown(bar_size, scale) {
+            return None;
+        }
+
+        let size = self.size(scale);
+        let margin = f64::max(2., self.spacing(scale) / 2.);
+        let mut group = self.group(bar_size, scale);
+        group.loc -= Point::from((margin, margin));
+        group.size += Size::from((margin * 2., margin * 2.));
+        if !group.contains(point) {
+            return None;
+        }
+
+        let x = point.x - group.loc.x;
+        let step = size + self.spacing(scale);
+        let idx = (x / step).floor().clamp(0., 2.) as usize;
+        Some(BUTTONS[idx])
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    pub fn render<R: NiriRenderer>(
+        &self,
+        renderer: &mut R,
+        // Location of the bar's top-left corner.
+        bar_loc: Point<f64, Logical>,
+        bar_size: Size<f64, Logical>,
+        scale: f64,
+        is_active: bool,
+        input: TrafficLightsInput,
+        alpha: f32,
+    ) -> Option<PrimaryGpuTextureRenderElement> {
+        if !self.is_shown(bar_size, scale) || alpha <= 0. {
+            return None;
+        }
+
+        let pressed = input.pressed.filter(|b| input.under == Some(*b));
+        let look = Look {
+            scale_bits: scale.to_bits(),
+            lit: is_active || input.hovered,
+            glyphs: input.hovered,
+            pressed,
+        };
+
+        let mut textures = self.textures.borrow_mut();
+        let buffer = textures.entry(look).or_insert_with(|| {
+            let buffer = draw(
+                &self.config,
+                self.size(scale),
+                self.spacing(scale),
+                scale,
+                look,
+            )
+            .map_err(|err| warn!("error drawing traffic lights: {err:?}"))
+            .ok()?;
+            TextureBuffer::from_memory_buffer(renderer.as_gles_renderer(), &buffer)
+                .map_err(|err| warn!("error uploading traffic lights: {err:?}"))
+                .ok()
+        });
+        let buffer = buffer.clone()?;
+
+        let loc = bar_loc + self.group(bar_size, scale).loc;
+        let loc = loc.to_physical_precise_round(scale).to_logical(scale);
+        let elem = TextureRenderElement::from_texture_buffer(
+            buffer,
+            loc,
+            alpha,
+            None,
+            None,
+            Kind::Unspecified,
+        );
+        Some(PrimaryGpuTextureRenderElement(elem))
+    }
+}
+
+fn scaled(color: Color, factor: f32) -> Color {
+    Color::new_unpremul(
+        (color.r * factor).min(1.),
+        (color.g * factor).min(1.),
+        (color.b * factor).min(1.),
+        color.a,
+    )
+}
+
+fn set_source(cr: &cairo::Context, color: Color, alpha: f32) {
+    cr.set_source_rgba(
+        color.r.into(),
+        color.g.into(),
+        color.b.into(),
+        (color.a * alpha).into(),
+    );
+}
+
+/// Draws the three buttons, like Loft's TrafficLights.qml: an Aqua bead (darker toward the
+/// bottom, a darker rim, a specular lens along the top) with its glyph on hover.
+fn draw(
+    config: &niri_config::TrafficLights,
+    size: f64,
+    spacing: f64,
+    scale: f64,
+    look: Look,
+) -> anyhow::Result<MemoryBuffer> {
+    let _span = tracy_client::span!("traffic_lights::draw");
+
+    let width = ((size * 3. + spacing * 2.) * scale).round() as i32;
+    let height = (size * scale).round() as i32;
+
+    let surface = ImageSurface::create(cairo::Format::ARgb32, width.max(1), height.max(1))?;
+    let cr = cairo::Context::new(&surface)?;
+    cr.scale(scale, scale);
+
+    let r = size / 2.;
+    let line = f64::max(1. / scale, size * 0.09);
+
+    for (i, button) in BUTTONS.into_iter().enumerate() {
+        let tint = match button {
+            TrafficLight::Close => config.close_color,
+            TrafficLight::Minimize => config.minimize_color,
+            TrafficLight::Zoom => config.zoom_color,
+        };
+        let base = if look.lit {
+            tint
+        } else {
+            config.inactive_color
+        };
+
+        let cx = r + i as f64 * (size + spacing);
+        let cy = r;
+
+        // The bead.
+        cr.new_path();
+        cr.arc(cx, cy, r, 0., 2. * PI);
+        if look.lit {
+            let gradient = LinearGradient::new(0., 0., 0., size);
+            let top = scaled(base, 1.12);
+            let bottom = scaled(base, 1. / 1.12);
+            gradient.add_color_stop_rgba(
+                0.,
+                top.r.into(),
+                top.g.into(),
+                top.b.into(),
+                top.a.into(),
+            );
+            gradient.add_color_stop_rgba(
+                1.,
+                bottom.r.into(),
+                bottom.g.into(),
+                bottom.b.into(),
+                bottom.a.into(),
+            );
+            cr.set_source(&gradient)?;
+        } else {
+            set_source(&cr, base, 1.);
+        }
+        cr.fill()?;
+
+        // The rim.
+        cr.new_path();
+        cr.arc(cx, cy, r - 0.5, 0., 2. * PI);
+        cr.set_line_width(1.);
+        if look.lit {
+            set_source(&cr, scaled(tint, 1. / 1.6), 0.55);
+        } else {
+            cr.set_source_rgba(0., 0., 0., 0.12);
+        }
+        cr.stroke()?;
+
+        if look.lit {
+            // The specular lens: a soft bright ellipse along the top.
+            let lens_w = size * 0.6;
+            let lens_h = size * 0.36;
+            let lens_y = size * 0.1;
+            cr.save()?;
+            cr.translate(cx, lens_y + lens_h / 2.);
+            cr.scale(lens_w / 2., lens_h / 2.);
+            cr.new_path();
+            cr.arc(0., 0., 1., 0., 2. * PI);
+            cr.restore()?;
+            let gradient = LinearGradient::new(0., lens_y, 0., lens_y + lens_h);
+            gradient.add_color_stop_rgba(0., 1., 1., 1., 0.7);
+            gradient.add_color_stop_rgba(1., 1., 1., 1., 0.);
+            cr.set_source(&gradient)?;
+            cr.fill()?;
+        }
+
+        if look.pressed == Some(button) {
+            cr.new_path();
+            cr.arc(cx, cy, r, 0., 2. * PI);
+            cr.set_source_rgba(0., 0., 0., 0.22);
+            cr.fill()?;
+        }
+
+        if look.glyphs {
+            set_source(&cr, config.glyph_color, 1.);
+            cr.set_line_width(line);
+            cr.set_line_cap(cairo::LineCap::Round);
+            cr.new_path();
+            match button {
+                TrafficLight::Close => {
+                    let d = size * 0.2;
+                    cr.move_to(cx - d, cy - d);
+                    cr.line_to(cx + d, cy + d);
+                    cr.move_to(cx + d, cy - d);
+                    cr.line_to(cx - d, cy + d);
+                    cr.stroke()?;
+                }
+                TrafficLight::Minimize => {
+                    let d = size * 0.26;
+                    cr.move_to(cx - d, cy);
+                    cr.line_to(cx + d, cy);
+                    cr.stroke()?;
+                }
+                TrafficLight::Zoom => {
+                    // Two triangles pointing at opposite corners, as on macOS.
+                    let far = size * 0.24;
+                    let near = size * 0.1;
+                    cr.move_to(cx - far, cy - far);
+                    cr.line_to(cx + near, cy - far);
+                    cr.line_to(cx - far, cy + near);
+                    cr.close_path();
+                    cr.move_to(cx + far, cy + far);
+                    cr.line_to(cx - near, cy + far);
+                    cr.line_to(cx + far, cy - near);
+                    cr.close_path();
+                    cr.fill()?;
+                }
+            }
+        }
+    }
+
+    drop(cr);
+
+    let data = surface.take_data().context("taking surface data")?;
+    Ok(MemoryBuffer::new(
+        data.to_vec(),
+        Fourcc::Argb8888,
+        (width.max(1), height.max(1)),
+        scale,
+        Transform::Normal,
+    ))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn lights() -> TrafficLights {
+        TrafficLights::new(niri_config::TrafficLights::default())
+    }
+
+    fn bar() -> Size<f64, Logical> {
+        Size::from((400., 30.))
+    }
+
+    #[test]
+    fn hit_buttons_and_gaps() {
+        let tl = lights();
+        // Defaults: 12 px buttons, 8 px apart, the first 12 px in, centered in the 30 px bar
+        // (y = 9..21).
+        let hit = |x: f64, y: f64| tl.hit(Point::from((x, y)), bar(), 1.);
+        assert_eq!(hit(18., 15.), Some(TrafficLight::Close));
+        assert_eq!(hit(38., 15.), Some(TrafficLight::Minimize));
+        assert_eq!(hit(58., 15.), Some(TrafficLight::Zoom));
+        // Half the spacing around the group still counts: no dead gaps.
+        assert_eq!(hit(27., 15.), Some(TrafficLight::Close));
+        assert_eq!(hit(8.5, 15.), Some(TrafficLight::Close));
+        assert_eq!(hit(67., 15.), Some(TrafficLight::Zoom));
+        assert_eq!(hit(18., 5.5), Some(TrafficLight::Close));
+        // Outside.
+        assert_eq!(hit(3., 15.), None);
+        assert_eq!(hit(18., 2.), None);
+        assert_eq!(hit(18., 28.), None);
+        assert_eq!(hit(80., 15.), None);
+    }
+
+    #[test]
+    fn off_never_hits() {
+        let tl = TrafficLights::new(niri_config::TrafficLights {
+            on: false,
+            ..Default::default()
+        });
+        assert_eq!(tl.hit(Point::from((18., 15.)), bar(), 1.), None);
+        assert_eq!(tl.end_x(bar(), 1.), 0.);
+    }
+
+    #[test]
+    fn shown_only_in_big_enough_bars() {
+        let tl = lights();
+        assert!(tl.is_shown(bar(), 1.));
+        // The group ends at x = 12 + 12 * 3 + 8 * 2 = 64.
+        assert_eq!(tl.end_x(bar(), 1.), 64.);
+        assert!(tl.is_shown(Size::from((64., 12.)), 1.));
+        assert!(!tl.is_shown(Size::from((63., 30.)), 1.));
+        assert!(!tl.is_shown(Size::from((200., 11.)), 1.));
+        assert_eq!(tl.end_x(Size::from((63., 30.)), 1.), 0.);
+    }
+
+    #[test]
+    fn y_offset_is_ignored() {
+        // Old configs set the offset from the window's corner; in the bar, the buttons center.
+        let tl = TrafficLights::new(niri_config::TrafficLights {
+            offset: niri_config::ShadowOffset {
+                x: niri_config::FloatOrInt(12.),
+                y: niri_config::FloatOrInt(14.),
+            },
+            ..Default::default()
+        });
+        assert_eq!(
+            tl.hit(Point::from((18., 15.)), bar(), 1.),
+            Some(TrafficLight::Close)
+        );
+    }
+
+    #[test]
+    fn draws_every_look() {
+        let config = niri_config::TrafficLights::default();
+        for scale in [1., 1.25, 2.] {
+            for lit in [false, true] {
+                for glyphs in [false, true] {
+                    for pressed in [None, Some(TrafficLight::Zoom)] {
+                        let look = Look {
+                            scale_bits: f64::to_bits(scale),
+                            lit,
+                            glyphs,
+                            pressed,
+                        };
+                        let buffer = draw(&config, 12., 8., scale, look).unwrap();
+                        let size = buffer.size();
