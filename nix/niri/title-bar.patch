+/// Whether a toplevel negotiated server-side decorations so far, like `Mapped::has_ssd()` but
+/// from the pending state: for the initial configure, before anything is committed.
+pub fn toplevel_has_pending_ssd(toplevel: &ToplevelSurface) -> bool {
+    match toplevel.with_pending_state(|state| state.decoration_mode) {
+        Some(zxdg_toplevel_decoration_v1::Mode::ServerSide) => true,
+        Some(_) => false,
+        None => with_states(toplevel.wl_surface(), |states| {
+            states
+                .data_map
+                .get::<KdeDecorationsModeState>()
+                .map(KdeDecorationsModeState::is_server)
+                == Some(true)
+        }),
+    }
+}
