diff -ruN a/src/protocols/toplevel_export.rs b/src/protocols/toplevel_export.rs
--- a/src/protocols/toplevel_export.rs
+++ b/src/protocols/toplevel_export.rs
@@ -0,0 +1,328 @@
+//! niri-loft: hyprland-toplevel-export-v1, a copy of one window's contents into a client's
+//! buffer.
+//!
+//! Quickshell's ScreencopyView captures a window (a wlr-foreign-toplevel handle) through this
+//! protocol; Loft's app switcher and dock previews use it for window thumbnails. A window is
+//! captured on any workspace, whether or not it is on screen, with its subsurfaces but without
+//! popups, borders, shadows or the traffic lights.
+//!
+//! Each copy renders the window right away. There is no damage tracking: a copy that asks to
+//! wait for damage gets full damage, so clients pace their own captures.
+
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::time::Duration;
+
+use anyhow::Context as _;
+use calloop::generic::Generic;
+use calloop::{Interest, Mode, PostAction};
+use smithay::backend::allocator::dmabuf::Dmabuf;
+use smithay::backend::allocator::{Buffer, Fourcc};
+use smithay::backend::renderer::damage::OutputDamageTracker;
+use smithay::backend::renderer::gles::GlesRenderer;
+use smithay::backend::renderer::sync::SyncPoint;
+use smithay::reexports::wayland_server::protocol::wl_buffer::WlBuffer;
+use smithay::reexports::wayland_server::protocol::wl_shm::Format;
+use smithay::reexports::wayland_server::protocol::wl_surface::WlSurface;
+use smithay::reexports::wayland_server::{
+    Client, DataInit, Dispatch, DisplayHandle, GlobalDispatch, New, Resource,
+};
+use smithay::utils::{Physical, Point, Scale, Size, Transform};
+use smithay::wayland::{dmabuf, shm};
+
+use super::raw::hyprland_toplevel_export::v1::server::{
+    hyprland_toplevel_export_frame_v1, hyprland_toplevel_export_manager_v1,
+};
+use crate::layout::LayoutElement as _;
+use crate::niri::{Niri, State};
+use crate::render_helpers::{render_to_dmabuf, render_to_shm, RenderCtx, RenderTarget};
+use crate::utils::get_monotonic_time;
+use hyprland_toplevel_export_frame_v1::{Flags, HyprlandToplevelExportFrameV1};
+use hyprland_toplevel_export_manager_v1::HyprlandToplevelExportManagerV1;
+
+const VERSION: u32 = 2;
+
+pub struct ToplevelExportGlobalData {
+    filter: Box<dyn for<'c> Fn(&'c Client) -> bool + Send + Sync>,
+}
+
+pub fn init(display: &DisplayHandle, filter: impl Fn(&Client) -> bool + Send + Sync + 'static) {
+    let global_data = ToplevelExportGlobalData {
+        filter: Box::new(filter),
+    };
+    display.create_global::<State, HyprlandToplevelExportManagerV1, _>(VERSION, global_data);
+}
+
+/// The window a frame captures, and its buffer size (fixed when the frame is created).
+#[derive(Clone)]
+struct Target {
+    surface: WlSurface,
+    size: Size<i32, Physical>,
+    scale: f64,
+}
+
+pub struct FrameData {
+    /// None: the window wasn't found, and the frame has failed.
+    target: Option<Target>,
+    copied: AtomicBool,
+}
+
+enum Destination {
+    Dmabuf(Dmabuf),
+    Shm(WlBuffer),
+}
+
+impl GlobalDispatch<HyprlandToplevelExportManagerV1, ToplevelExportGlobalData> for State {
+    fn bind(
+        _state: &mut Self,
+        _handle: &DisplayHandle,
+        _client: &Client,
+        resource: New<HyprlandToplevelExportManagerV1>,
+        _global_data: &ToplevelExportGlobalData,
+        data_init: &mut DataInit<'_, Self>,
+    ) {
+        data_init.init(resource, ());
+    }
+
+    fn can_view(client: Client, global_data: &ToplevelExportGlobalData) -> bool {
+        (global_data.filter)(&client)
+    }
+}
+
+impl Dispatch<HyprlandToplevelExportManagerV1, ()> for State {
+    fn request(
+        state: &mut Self,
+        _client: &Client,
+        _manager: &HyprlandToplevelExportManagerV1,
+        request: hyprland_toplevel_export_manager_v1::Request,
+        _data: &(),
+        _dhandle: &DisplayHandle,
+        data_init: &mut DataInit<'_, Self>,
+    ) {
+        let (frame, surface) = match request {
+            // The handle is niri's window id here (Hyprland's is a window address).
+            hyprland_toplevel_export_manager_v1::Request::CaptureToplevel {
+                frame, handle, ..
+            } => {
+                let surface = state
+                    .niri
+                    .layout
+                    .windows()
+                    .find(|(_, mapped)| mapped.id().get() == u64::from(handle))
+                    .map(|(_, mapped)| mapped.toplevel().wl_surface().clone());
+                (frame, surface)
+            }
+            hyprland_toplevel_export_manager_v1::Request::CaptureToplevelWithWlrToplevelHandle {
+                frame,
+                handle,
+                ..
+            } => {
+                let surface = state
+                    .niri
+                    .foreign_toplevel_state
+                    .wlr_handle_surface(&handle);
+                (frame, surface)
+            }
+            hyprland_toplevel_export_manager_v1::Request::Destroy => return,
+        };
+
+        let target = surface.and_then(|surface| target(&state.niri, surface));
+        let Some(target) = target else {
+            trace!("toplevel export: no such window");
+            let frame = data_init.init(
+                frame,
+                FrameData {
+                    target: None,
+                    copied: AtomicBool::new(true),
+                },
+            );
+            frame.failed();
+            return;
+        };
+
+        let size = target.size;
+        let frame = data_init.init(
+            frame,
+            FrameData {
+                target: Some(target),
+                copied: AtomicBool::new(false),
+            },
+        );
+
+        frame.buffer(
+            Format::Xrgb8888,
+            size.w as u32,
+            size.h as u32,
+            size.w as u32 * 4,
+        );
+        // With alpha: rounded window corners stay transparent.
+        frame.linux_dmabuf(Fourcc::Argb8888 as u32, size.w as u32, size.h as u32);
+        frame.buffer_done();
+    }
+}
+
+impl Dispatch<HyprlandToplevelExportFrameV1, FrameData> for State {
+    fn request(
+        state: &mut Self,
+        _client: &Client,
+        frame: &HyprlandToplevelExportFrameV1,
+        request: hyprland_toplevel_export_frame_v1::Request,
+        data: &FrameData,
+        _dhandle: &DisplayHandle,
+        _data_init: &mut DataInit<'_, Self>,
+    ) {
+        let hyprland_toplevel_export_frame_v1::Request::Copy {
+            buffer,
+            ignore_damage,
+        } = request
+        else {
+            return;
+        };
+        let Some(target) = &data.target else {
+            return;
+        };
+
+        if data.copied.swap(true, Ordering::SeqCst) {
+            frame.post_error(
+                hyprland_toplevel_export_frame_v1::Error::AlreadyUsed,
+                "copy was already requested",
+            );
+            return;
+        }
+
+        let size = target.size;
+        let destination = if let Ok(dmabuf) = dmabuf::get_dmabuf(&buffer) {
+            if matches!(dmabuf.format().code, Fourcc::Argb8888 | Fourcc::Xrgb8888)
+                && dmabuf.width() == size.w as u32
+                && dmabuf.height() == size.h as u32
+            {
+                Destination::Dmabuf(dmabuf.clone())
+            } else {
+                frame.post_error(
+                    hyprland_toplevel_export_frame_v1::Error::InvalidBuffer,
+                    "invalid dmabuf parameters",
+                );
+                return;
+            }
+        } else if shm::with_buffer_contents(&buffer, |_, shm_len, buffer_data| {
+            buffer_data.format == Format::Xrgb8888
+                && buffer_data.width == size.w
+                && buffer_data.height == size.h
+                && buffer_data.stride == size.w * 4
+                && shm_len == buffer_data.stride as usize * buffer_data.height as usize
+        })
+        .unwrap_or(false)
+        {
+            Destination::Shm(buffer)
+        } else {
+            frame.post_error(
+                hyprland_toplevel_export_frame_v1::Error::InvalidBuffer,
+                "invalid buffer",
+            );
+            return;
+        };
+
+        let niri = &state.niri;
+        let res = state
+            .backend
+            .with_primary_renderer(|renderer| render(niri, renderer, target, &destination));
+
+        match res {
+            Some(Ok(sync)) => {
+                if ignore_damage == 0 {
+                    frame.damage(0, 0, size.w as u32, size.h as u32);
+                }
+                submit_after_sync(frame.clone(), sync, niri);
+            }
+            Some(Err(err)) => {
+                debug!("toplevel export: error rendering: {err:?}");
+                frame.failed();
+            }
+            None => frame.failed(),
+        }
+    }
+}
+
+/// The window behind `surface`, sized in physical px of the display it's on.
+fn target(niri: &Niri, surface: WlSurface) -> Option<Target> {
+    let (mapped, output) = niri.layout.find_window_and_output(&surface)?;
+    let scale = output.map_or(1., |output| output.current_scale().fractional_scale());
+    let size: Size<i32, Physical> = mapped.size().to_f64().to_physical_precise_round(scale);
+    if size.w <= 0 || size.h <= 0 {
+        return None;
+    }
+    Some(Target {
+        surface,
+        size,
+        scale,
+    })
+}
+
+fn render(
+    niri: &Niri,
+    renderer: &mut GlesRenderer,
+    target: &Target,
+    destination: &Destination,
+) -> anyhow::Result<Option<SyncPoint>> {
+    let (mapped, _) = niri
+        .layout
+        .find_window_and_output(&target.surface)
+        .context("window is gone")?;
+
+    let scale = Scale::from(target.scale);
+    let mut elements = Vec::new();
+    mapped.render_normal(
+        RenderCtx {
+            renderer,
+            target: RenderTarget::ScreenCapture,
+            xray: None,
+        },
+        Point::from((0., 0.)),
+        scale,
+        1.,
+        &mut |elem| elements.push(elem),
+    );
+
+    let mut damage_tracker = OutputDamageTracker::new(target.size, scale, Transform::Normal);
+    let (_, states) = damage_tracker
+        .damage_output(1, &elements)
+        .context("error computing damage")?;
+
+    match destination {
+        Destination::Dmabuf(dmabuf) => render_to_dmabuf(
+            renderer,
+            &mut damage_tracker,
+            dmabuf.clone(),
+            &elements,
+            states,
+        )
+        .map(Some),
+        Destination::Shm(buffer) => {
+            render_to_shm(renderer, &mut damage_tracker, buffer, &elements, states).map(|()| None)
+        }
+    }
+}
+
+fn submit(frame: &HyprlandToplevelExportFrameV1, timestamp: Duration) {
+    frame.flags(Flags::empty());
+    let tv_sec_hi = (timestamp.as_secs() >> 32) as u32;
+    let tv_sec_lo = (timestamp.as_secs() & 0xFFFFFFFF) as u32;
+    frame.ready(tv_sec_hi, tv_sec_lo, timestamp.subsec_nanos());
+}
+
+fn submit_after_sync(frame: HyprlandToplevelExportFrameV1, sync: Option<SyncPoint>, niri: &Niri) {
+    let timestamp = get_monotonic_time();
+    match sync.and_then(|s| s.export()) {
+        None => submit(&frame, timestamp),
+        Some(sync_fd) => {
+            let source = Generic::new(sync_fd, Interest::READ, Mode::OneShot);
+            niri.event_loop
+                .insert_source(source, move |_, _, _| {
+                    if frame.is_alive() {
+                        submit(&frame, timestamp);
+                    }
+                    Ok(PostAction::Remove)
+                })
+                .unwrap();
+        }
+    }
+}
