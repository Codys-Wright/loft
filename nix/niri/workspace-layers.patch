+#[test]
+fn place_within_workspace() {
+    let config = r##"
+workspace "one"
+workspace "two"
+
+animations {
+    off
+}
+
+layer-rule {
+    match namespace="^wp@(.+)$"
+    place-within-workspace "$1"
+}
+"##;
+    let config = Config::parse_mem(config).unwrap();
+    let mut f = Fixture::with_config(config);
+    f.add_output(1, (1920, 1080));
+    let id = f.add_client();
+
+    // Bound by name, and by index (workspace "two" is the second one).
+    map_fullscreen_background(&mut f, id, "wp@one");
+    map_fullscreen_background(&mut f, id, "wp@2");
+
+    // Each shows (and takes input) only on its own workspace.
+    assert_eq!(background_under_center(&mut f).as_deref(), Some("wp@one"));
+
+    f.niri().layout.switch_workspace(1);
+    f.niri_complete_animations();
+    assert_eq!(background_under_center(&mut f).as_deref(), Some("wp@2"));
+
+    // The empty workspace after them has none.
+    f.niri().layout.switch_workspace(2);
+    f.niri_complete_animations();
+    assert_eq!(background_under_center(&mut f), None);
+
+    // An unbound background surface keeps the stock behavior: on every workspace.
+    map_fullscreen_background(&mut f, id, "plain");
+    assert_eq!(background_under_center(&mut f).as_deref(), Some("plain"));
+    f.niri().layout.switch_workspace(0);
+    f.niri_complete_animations();
+    let hit = background_under_center(&mut f);
+    assert!(hit.as_deref() == Some("plain") || hit.as_deref() == Some("wp@one"));
+}
