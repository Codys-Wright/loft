+/// A workspace a layer surface is bound to (`place-within-workspace`).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum WorkspaceBinding {
+    /// 1-based index on the layer surface's output.
+    Index(u8),
+    /// Workspace name (case-insensitive, like everywhere else).
+    Name(String),
+}
+
+impl WorkspaceBinding {
+    /// Expands `$1` / `${name}` from the matching namespace regex, then reads the result like
+    /// a workspace reference on the command line: a number is an index, anything else a name.
+    pub fn resolve(template: &str, matched: Option<&Match>, namespace: &str) -> Self {
+        let mut value = String::new();
+        match matched
+            .and_then(|m| m.namespace.as_ref())
+            .and_then(|re| re.0.captures(namespace))
+        {
+            Some(caps) => caps.expand(template, &mut value),
+            None => value.push_str(template),
+        }
+
+        match value.parse::<u8>() {
+            Ok(idx) => Self::Index(idx),
+            Err(_) => Self::Name(value),
+        }
+    }
+
+    /// Whether this is the workspace at `idx` (0-based) on its monitor, with `name`.
+    pub fn matches(&self, idx: usize, name: Option<&str>) -> bool {
+        match self {
+            Self::Index(i) => usize::from(*i) == idx + 1,
+            Self::Name(n) => name.is_some_and(|name| name.eq_ignore_ascii_case(n)),
+        }
+    }
+}
