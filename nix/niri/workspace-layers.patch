+#[cfg(test)]
+mod tests {
+    use niri_config::utils::RegexEq;
+
+    use super::*;
+
+    fn ns_match(re: &str) -> Match {
+        Match {
+            namespace: Some(RegexEq(re.parse().unwrap())),
+            at_startup: None,
+            layer: None,
+        }
+    }
+
+    #[test]
+    fn binding_expands_captures() {
+        let m = ns_match("^wallpaper@(.+)$");
+        assert_eq!(
+            WorkspaceBinding::resolve("$1", Some(&m), "wallpaper@dev"),
+            WorkspaceBinding::Name("dev".into())
+        );
+        assert_eq!(
+            WorkspaceBinding::resolve("${1}", Some(&m), "wallpaper@3"),
+            WorkspaceBinding::Index(3)
+        );
+        let named = ns_match("^w-(?<ws>.+)$");
+        assert_eq!(
+            WorkspaceBinding::resolve("${ws}", Some(&named), "w-chat"),
+            WorkspaceBinding::Name("chat".into())
+        );
+        // No match context: the template is the reference.
+        assert_eq!(
+            WorkspaceBinding::resolve("mail", None, "anything"),
+            WorkspaceBinding::Name("mail".into())
+        );
+    }
+
+    #[test]
+    fn binding_matches_workspaces() {
+        let idx = WorkspaceBinding::Index(2);
+        assert!(idx.matches(1, None));
+        assert!(!idx.matches(0, None));
+        assert!(!idx.matches(2, Some("2")));
+
+        let name = WorkspaceBinding::Name("Dev".into());
+        assert!(name.matches(5, Some("dev")));
+        assert!(!name.matches(5, Some("chat")));
+        assert!(!name.matches(5, None));
+    }
+}
