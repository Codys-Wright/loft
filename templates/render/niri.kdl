// studio-linux theme "${name}" — generated by `studio theme render`, do not edit.
//
// Included after studio's base.kdl (include optional=true ".../current/niri.kdl"),
// so it overrides only the theme-owned settings below.

layout {
    focus-ring {
        active-color "${focus_active}"
        inactive-color "${focus_inactive}"
        urgent-color "${urgent}"
    }

    // Colors only: whether the border is drawn stays the base/consumer's call.
    border {
        active-color "${accent}"
        inactive-color "${overlay}"
        urgent-color "${urgent}"
    }

    shadow {
        color "${shadow}"
    }
}

overview {
    backdrop-color "${bg}"
}

// glass.blur, glass.noise, glass.saturation. `off` also disables blur that
// windows request themselves; `on` re-enables it after an earlier `off`.
blur {
    ${niri_blur}
    noise ${glass_noise}
    saturation ${glass_saturation}
}

window-rule {
    geometry-corner-radius ${window_radius}
    clip-to-geometry true
}
${niri_xray_rules}
