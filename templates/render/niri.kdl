// Loft theme "${name}" — generated by `loft theme render`, do not edit.
//
// Included after Loft's base.kdl (include optional=true ".../current/niri.kdl"),
// so it overrides only the theme-owned settings below.

layout {
${niri_gaps}    // shape.focus: "shadow" marks the focused window with its deeper shadow
    // alone (no ring); "ring" and "both" draw the ring, focusRing.width wide.
    focus-ring {
        ${niri_focus_ring}
        active-color "${focus_active}"
        inactive-color "${focus_inactive}"
        urgent-color "${urgent}"
    }

    // shape.border: drawn or not, and how wide.
    border {
        ${niri_border}
        active-color "${accent}"
        inactive-color "${overlay}"
        urgent-color "${urgent}"
    }

    // glass.shadow on the focused window, a fainter one on the rest
    // (base.kdl makes the focused window's shadow larger, too).
    shadow {
        color "${shadow}"
        inactive-color "${shadow_inactive}"
    }
}

overview {
    backdrop-color "${bg}"
}

// ⌘Tab switcher (binds in the shell's keybind fragment).
recent-windows {
    highlight {
        active-color "${accent}"
        urgent-color "${urgent}"
        corner-radius ${window_radius}
    }
}

// glass.blur, glass.noise, glass.saturation. `off` also disables blur that
// windows request themselves; `on` re-enables it after an earlier `off`.
blur {
    ${niri_blur}
    noise ${glass_noise}
    saturation ${glass_saturation}
}

// shape.windowRadius: one corner radius for every window, the shell's
// own windows included (they draw their glass with the same radius).
window-rule {
    geometry-corner-radius ${window_radius}
    clip-to-geometry true
}
${niri_xray_rules}${niri_focus_rules}${niri_animations}

// Glass sidebars (docs/DESIGN-GOLDEN-GATE.md): Loft's gtk.css makes these apps'
// windows transparent and their sidebars a tint of the glass; niri blurs what is
// behind them. One app id per glass window class in gtk.css (GTK CSS can't see
// app ids): Nautilus, which also draws the portal file chooser GTK apps get
// (.nautilus-file-chooser, same app id). Add an app here only together with
// its CSS: a blur rule alone does nothing, a transparent window alone shows
// the desktop unblurred. niri paints the focus ring / border as a solid
// rectangle behind the window by default; with a transparent window that
// shows through as a colored slab when it's focused, so not behind glass.
//
// Dolphin: Loft's Kvantum theme (qt unit, programs.loft.qt) draws its window
// as the same glass (toolbar, Places, status bar; the file view opaque).
window-rule {
    match app-id="^org\\.gnome\\.Nautilus$$"
    draw-border-with-background false
    background-effect {
        blur true
    }
}
window-rule {
    match app-id="^org\\.kde\\.dolphin$$"
    draw-border-with-background false
    background-effect {
        blur true
    }
}
