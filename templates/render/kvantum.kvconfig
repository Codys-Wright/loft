# Loft theme "${name}" — Kvantum theme "Loft", generated by `loft theme render`, do not edit.
# Linked to ~/.config/Kvantum/Loft/Loft.kvconfig by the `qt` hook and used
# only by the apps ~/.config/loft/qt.json lists (kvantum.kvconfig [Applications]).
# Glass: windows are translucent (the `window` element), niri blurs behind
# them (templates/render/niri.kdl), Kvantum's own (KWin) blur is off.

[%General]
author=Loft
comment=Golden Gate glass for Qt apps, from the active Loft theme
x11drag=none
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
mirror_doc_tabs=false
joined_inactive_tabs=true
group_toolbar_buttons=false
spread_progressbar=true
spread_header=true
composite=true
translucent_windows=true
reduce_window_opacity=0
reduce_menu_opacity=0
blurring=false
popup_blurring=false
shadowless_popup=true
menu_shadow_depth=0
tooltip_shadow_depth=0
opaque=kaffeine,kmplayer,subtitlecomposer,kdenlive,vlc,smplayer,smplayer2,avidemux,kamoso,QtCreator,VirtualBox,VirtualBoxVM,dragon,digikam,lyx,haruna,mpv
respect_DE=false
animate_states=true
no_inactiveness=false
no_window_pattern=true
dark_titlebar=${dark}
splitter_width=1
scroll_width=10
scroll_min_extent=36
scroll_arrows=false
scrollbar_in_view=true
transient_scrollbar=true
transient_groove=false
slider_width=4
slider_handle_width=16
slider_handle_length=16
tree_branch_line=false
check_size=16
progressbar_thickness=4
textless_progressbar=false
menubar_mouse_tracking=true
merge_menubar_with_toolbar=false
toolbutton_style=0
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=16
toolbar_interior_spacing=2
toolbar_item_spacing=2
toolbar_separator_thickness=1
layout_spacing=6
layout_margin=8
submenu_overlap=0
submenu_delay=200
tooltip_delay=-1
spin_button_width=16
inline_spin_indicators=true
vertical_spin_indicators=false
combo_as_lineedit=false
combo_menu=true
combo_focus_rect=false
hide_combo_checkboxes=true
groupbox_top_label=true
button_contents_shift=false
click_behavior=0
dialog_button_layout=0
fill_rubberband=false
scrollable_menu=true
drag_from_buttons=false

[GeneralColors]
window.color=${bg}
inactive.window.color=${bg}
base.color=${view}
inactive.base.color=${view}
alt.base.color=${view_alt}
inactive.alt.base.color=${view_alt}
button.color=${button}
light.color=${overlay}
mid.light.color=${surface}
dark.color=${bg}
mid.color=${surface}
shadow.color=#000000
highlight.color=${highlight}
inactive.highlight.color=${highlight}
tooltip.base.color=${raised}
text.color=${text}
inactive.text.color=${text}
window.text.color=${text}
inactive.window.text.color=${subtext}
button.text.color=${text}
disabled.text.color=${disabled}
tooltip.text.color=${text}
highlight.text.color=${text}
inactive.highlight.text.color=${text}
link.color=${accent}
link.visited.color=${accent2}
progress.indicator.text.color=${text}
placeholder.text.color=${subtext}

[Hacks]
transparent_dolphin_view=false
transparent_pcmanfm_sidepane=true
transparent_pcmanfm_view=false
transparent_ktitle_label=true
transparent_menutitle=true
blur_translucent=false
respect_darkness=true
kcapacitybar_as_progressbar=true
force_size_grip=false
iconless_pushbutton=false
iconless_menu=false
disabled_icon_opacity=50
no_selection_tint=true
normal_default_pushbutton=true
single_top_toolbar=true
style_vertical_toolbars=false
tint_on_mouseover=0
middle_click_scroll=false
opaque_colors=false
centered_forms=false
kinetic_scrolling=false
noninteger_translucency=false
transparent_arrow_button=true
blur_only_active_window=false

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=${ctl}
frame.bottom=${ctl}
frame.left=${ctl}
frame.right=${ctl}
frame.expansion=0
interior=true
interior.element=button
indicator.size=10
indicator.element=arrow
text.normal.color=${text}
text.focus.color=${text}
text.press.color=${text}
text.toggle.color=${text}
text.disabled.color=${disabled}
text.shadow=false
text.margin.top=2
text.margin.bottom=2
text.margin.left=8
text.margin.right=8
text.iconspacing=6
min_width=+0.3font
min_height=+0.3font

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton
text.margin.left=4
text.margin.right=4
text.normal.color=${text}
text.focus.color=${text}
text.press.color=${text}
text.toggle.color=${text}
text.normal.inactive.color=${subtext}

[ToolbarButton]
inherits=PanelButtonTool

[Toolbar]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=arrow
indicator.size=8
text.normal.color=${text}
text.focus.color=${text}

[Dock]
inherits=PanelButtonCommand
frame=false
interior=false

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.normal.color=${subtext}
text.focus.color=${text}
text.bold=true

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=arrow
indicator.size=10

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio
text.margin.left=4
text.margin.right=4

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox
text.margin.left=4
text.margin.right=4

[Focus]
frame=false
interior=false

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
interior.element=common
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
text.margin.left=6
text.margin.right=6

[ToolbarLineEdit]
inherits=LineEdit

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow
frame=false
interior=false

[IndicatorArrow]
indicator.element=arrow
indicator.size=10

[ToolboxTab]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
indicator.element=arrow
text.normal.color=${subtext}
text.focus.color=${text}
text.toggle.color=${text}
text.margin.left=12
text.margin.right=12
text.margin.top=4
text.margin.bottom=4

[TabFrame]
inherits=PanelButtonCommand
frame=false
interior=false
frame.element=tabframe

[TabBarFrame]
inherits=GenericFrame
frame=false
interior=false

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=arrow
indicator.size=10

[HeaderSection]
inherits=PanelButtonCommand
frame.element=header
interior.element=header
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.normal.color=${subtext}
text.focus.color=${text}
text.press.color=${text}
text.toggle.color=${subtext}
text.margin.left=6
text.margin.right=6
text.margin.top=2
text.margin.bottom=2

[SizeGrip]
indicator.element=sizegrip

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.normal.color=${text}
text.focus.color=${text}
text.bold=false

[ProgressbarContents]
inherits=PanelButtonCommand
frame.element=progress-pattern
interior.element=progress-pattern
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[ItemView]
inherits=PanelButtonCommand
frame.element=itemview
interior.element=itemview
frame.top=${ctl}
frame.bottom=${ctl}
frame.left=${ctl}
frame.right=${ctl}
text.margin=0
text.margin.top=0
text.margin.bottom=0
text.margin.left=0
text.margin.right=0
text.normal.color=${text}
text.focus.color=${text}
text.press.color=${text}
text.toggle.color=${text}
min_width=0
min_height=0

[Splitter]
frame=false
interior=true
interior.element=splitter
indicator.element=splitter-grip
indicator.size=0

[Scrollbar]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=arrow
indicator.size=8

[ScrollbarGroove]
frame=false
interior=false

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior.element=scrollbarslider
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
indicator.element=grip
indicator.size=0

[ScrollbarTransientSlider]
inherits=ScrollbarSlider

[MenuItem]
inherits=PanelButtonCommand
frame=true
frame.element=menuitem
interior.element=menuitem
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
indicator.element=arrow
min_width=0
min_height=0
text.normal.color=${text}
text.focus.color=${on_accent}
text.press.color=${on_accent}
text.toggle.color=${on_accent}
text.margin.top=1
text.margin.bottom=1
text.margin.left=6
text.margin.right=6

[MenuBarItem]
inherits=PanelButtonCommand
frame.element=menubaritem
interior.element=menubaritem
text.margin.left=6
text.margin.right=6

[MenuBar]
frame=false
interior=false

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior=false
text.normal.color=${subtext}
text.focus.color=${text}

[ComboBox]
inherits=PanelButtonCommand

[ToolbarComboBox]
inherits=ComboBox

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
frame.top=${srf}
frame.bottom=${srf}
frame.left=${srf}
frame.right=${srf}
text.normal.color=${text}

[GroupBox]
inherits=GenericFrame
frame=true
frame.element=group
interior=true
interior.element=group
frame.top=${ctl}
frame.bottom=${ctl}
frame.left=${ctl}
frame.right=${ctl}
text.normal.color=${text}
text.bold=true

[ToolTip]
inherits=GenericFrame
frame=true
interior=true
frame.element=tooltip
interior.element=tooltip
frame.top=${ctl}
frame.bottom=${ctl}
frame.left=${ctl}
frame.right=${ctl}
text.normal.color=${text}
text.margin.left=4
text.margin.right=4

[StatusBar]
frame=false
interior=false

[Window]
interior=true
interior.element=window
frame=false

[WindowTranslucent]
inherits=Window

[Dialog]
inherits=Window
