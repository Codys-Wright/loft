// Loft theme "${name}" — generated by `loft theme render`, do not edit.
//
// What only Loft's niri (niri-loft) parses: stock niri rejects this file, so
// only sessions running niri-loft include it, after niri/title-bar.kdl.

// The title bar (nix/niri/title-bar.patch) in the colors GTK header bars get
// from gtk.css, so a terminal's or a Qt app's bar matches a GTK app's.
layout {
    title-bar {
        active-color "${title_bar_active}"
        inactive-color "${title_bar_inactive}"
        active-text-color "${title_bar_text}"
        inactive-text-color "${title_bar_text_inactive}"
    }
    traffic-lights {
        inactive-color "${traffic_inactive}"
    }
}
