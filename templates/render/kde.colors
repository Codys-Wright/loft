# Loft theme "${name}" — KDE color scheme "Loft", generated by `loft theme render`, do not edit.
# Linked to ~/.local/share/color-schemes/Loft.colors by the `qt` hook; KDE apps
# use it when their rc file says [UiSettings] ColorScheme=Loft (dolphinrc).

[General]
ColorScheme=Loft
Name=Loft
shadeSortColumn=false
TitlebarIsAccentColored=false
AccentColor=${kde_accent}

[KDE]
contrast=4

[ColorEffects:Disabled]
Color=${kde_bg}
ColorAmount=0
ColorEffect=0
ContrastAmount=0.55
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=${kde_bg}
ColorAmount=0
ColorEffect=0
ContrastAmount=0
ContrastEffect=0
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Window]
BackgroundNormal=${kde_bg}
BackgroundAlternate=${kde_surface}
ForegroundNormal=${kde_text}
ForegroundInactive=${kde_subtext}
ForegroundActive=${kde_accent}
ForegroundLink=${kde_accent}
ForegroundVisited=${kde_accent2}
ForegroundNegative=${kde_urgent}
ForegroundNeutral=${kde_warn}
ForegroundPositive=${kde_ok}
DecorationFocus=${kde_accent}
DecorationHover=${kde_accent}

[Colors:Header]
BackgroundNormal=${kde_bg}
BackgroundAlternate=${kde_surface}
ForegroundNormal=${kde_text}
ForegroundInactive=${kde_subtext}
ForegroundActive=${kde_accent}
ForegroundLink=${kde_accent}
ForegroundVisited=${kde_accent2}
ForegroundNegative=${kde_urgent}
ForegroundNeutral=${kde_warn}
ForegroundPositive=${kde_ok}
DecorationFocus=${kde_accent}
DecorationHover=${kde_accent}

[Colors:View]
BackgroundNormal=${kde_view}
BackgroundAlternate=${kde_view_alt}
ForegroundNormal=${kde_text}
ForegroundInactive=${kde_subtext}
ForegroundActive=${kde_accent}
ForegroundLink=${kde_accent}
ForegroundVisited=${kde_accent2}
ForegroundNegative=${kde_urgent}
ForegroundNeutral=${kde_warn}
ForegroundPositive=${kde_ok}
DecorationFocus=${kde_accent}
DecorationHover=${kde_accent}

[Colors:Button]
BackgroundNormal=${kde_button}
BackgroundAlternate=${kde_surface}
ForegroundNormal=${kde_text}
ForegroundInactive=${kde_subtext}
ForegroundActive=${kde_accent}
ForegroundLink=${kde_accent}
ForegroundVisited=${kde_accent2}
ForegroundNegative=${kde_urgent}
ForegroundNeutral=${kde_warn}
ForegroundPositive=${kde_ok}
DecorationFocus=${kde_accent}
DecorationHover=${kde_accent}

[Colors:Selection]
BackgroundNormal=${kde_highlight}
BackgroundAlternate=${kde_highlight}
ForegroundNormal=${kde_text}
ForegroundInactive=${kde_subtext}
ForegroundActive=${kde_text}
ForegroundLink=${kde_text}
ForegroundVisited=${kde_text}
ForegroundNegative=${kde_urgent}
ForegroundNeutral=${kde_warn}
ForegroundPositive=${kde_ok}
DecorationFocus=${kde_accent}
DecorationHover=${kde_accent}

[Colors:Tooltip]
BackgroundNormal=${kde_raised}
BackgroundAlternate=${kde_surface}
ForegroundNormal=${kde_text}
ForegroundInactive=${kde_subtext}
ForegroundActive=${kde_accent}
ForegroundLink=${kde_accent}
ForegroundVisited=${kde_accent2}
ForegroundNegative=${kde_urgent}
ForegroundNeutral=${kde_warn}
ForegroundPositive=${kde_ok}
DecorationFocus=${kde_accent}
DecorationHover=${kde_accent}

[Colors:Complementary]
BackgroundNormal=${kde_surface}
BackgroundAlternate=${kde_overlay}
ForegroundNormal=${kde_text}
ForegroundInactive=${kde_subtext}
ForegroundActive=${kde_accent}
ForegroundLink=${kde_accent}
ForegroundVisited=${kde_accent2}
ForegroundNegative=${kde_urgent}
ForegroundNeutral=${kde_warn}
ForegroundPositive=${kde_ok}
DecorationFocus=${kde_accent}
DecorationHover=${kde_accent}

[WM]
activeBackground=${kde_bg}
activeBlend=${kde_bg}
activeForeground=${kde_text}
inactiveBackground=${kde_bg}
inactiveBlend=${kde_bg}
inactiveForeground=${kde_subtext}
